{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { receivedWeekly, weeklyDetail, reviewWeekly } from '@/api/weekly';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDate } from '@/utils/format';\nimport { WEEKLY_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'WeeklyReceived',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(receivedWeekly, {\n      state: '',\n      current: 1,\n      size: 10\n    });\n    const detailVisible = ref(false);\n    const reviewVisible = ref(false);\n    const reviewing = ref(false);\n    const current = ref(null);\n    const reviewForm = reactive({\n      reportId: null,\n      score: 5,\n      comment: ''\n    });\n    async function showDetail(row) {\n      try {\n        current.value = await weeklyDetail(row.reportId);\n      } catch {\n        current.value = row;\n      }\n      detailVisible.value = true;\n    }\n    function openReview(row) {\n      reviewForm.reportId = row.reportId;\n      reviewForm.score = 5;\n      reviewForm.comment = '';\n      reviewVisible.value = true;\n    }\n    async function handleReview() {\n      if (!reviewForm.score) {\n        success('请选择评分');\n        return;\n      }\n      reviewing.value = true;\n      try {\n        await reviewWeekly({\n          ...reviewForm\n        });\n        success('评价已提交');\n        reviewVisible.value = false;\n        detailVisible.value = false;\n        fetchList();\n      } finally {\n        reviewing.value = false;\n      }\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      detailVisible,\n      reviewVisible,\n      reviewing,\n      current,\n      reviewForm,\n      showDetail,\n      openReview,\n      handleReview,\n      ref,\n      reactive,\n      onMounted,\n      get receivedWeekly() {\n        return receivedWeekly;\n      },\n      get weeklyDetail() {\n        return weeklyDetail;\n      },\n      get reviewWeekly() {\n        return reviewWeekly;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      get WEEKLY_STATE_MAP() {\n        return WEEKLY_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","receivedWeekly","weeklyDetail","reviewWeekly","usePagination","formatDate","WEEKLY_STATE_MAP","success","PageHeader","StateBadge","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","state","current","size","detailVisible","reviewVisible","reviewing","reviewForm","reportId","score","comment","showDetail","row","value","openReview","handleReview"],"sources":["F:/sxzp/project0/frontend/src/views/company/WeeklyReceived.vue"],"sourcesContent":["<template>\n  <div class=\"weekly-received\">\n    <PageHeader title=\"收到的周报\" desc=\"查看学生周报并评价\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.state\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"submitted\">待评价</el-radio-button>\n        <el-radio-button label=\"reviewed\">已评价</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"studentName\" label=\"学生\" min-width=\"100\" />\n        <el-table-column prop=\"jobTitle\" label=\"岗位\" min-width=\"140\" />\n        <el-table-column label=\"周次\" width=\"80\">\n          <template #default=\"{ row }\">第 {{ row.weekNum }} 周</template>\n        </el-table-column>\n        <el-table-column label=\"本周时间\" min-width=\"200\">\n          <template #default=\"{ row }\">\n            {{ formatDate(row.startDate) }} ~ {{ formatDate(row.endDate) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.state\" :map=\"WEEKLY_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"评分\" width=\"160\">\n          <template #default=\"{ row }\">\n            <el-rate v-if=\"row.reviewScore\" v-model=\"row.reviewScore\" disabled />\n            <span v-else>-</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"showDetail(row)\">查看详情</el-button>\n            <el-button\n              v-if=\"row.state === 'submitted'\"\n              size=\"small\"\n              type=\"primary\"\n              @click=\"openReview(row)\"\n            >\n              评价\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无周报\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <!-- 详情 -->\n    <el-dialog v-model=\"detailVisible\" title=\"周报详情\" width=\"640px\">\n      <template v-if=\"current\">\n        <h3>第 {{ current.weekNum }} 周（{{ formatDate(current.startDate) }} ~ {{ formatDate(current.endDate) }}）</h3>\n        <h4>本周内容</h4>\n        <pre class=\"content-pre\">{{ current.content || '暂无' }}</pre>\n        <h4>下周计划</h4>\n        <pre class=\"content-pre\">{{ current.plan || '暂无' }}</pre>\n        <h4>遇到的问题</h4>\n        <pre class=\"content-pre\">{{ current.problem || '暂无' }}</pre>\n        <template v-if=\"current.state === 'reviewed'\">\n          <h4>企业评价</h4>\n          <el-rate v-model=\"current.reviewScore\" disabled />\n          <pre class=\"content-pre\">{{ current.reviewComment || '暂无评语' }}</pre>\n        </template>\n      </template>\n      <template #footer>\n        <el-button v-if=\"current?.state === 'submitted'\" type=\"primary\" @click=\"openReview(current)\">\n          评价\n        </el-button>\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n\n    <!-- 评价 -->\n    <el-dialog v-model=\"reviewVisible\" title=\"评价周报\" width=\"500px\">\n      <el-form :model=\"reviewForm\" label-width=\"80px\">\n        <el-form-item label=\"评分\">\n          <el-rate v-model=\"reviewForm.score\" />\n        </el-form-item>\n        <el-form-item label=\"评语\">\n          <el-input v-model=\"reviewForm.comment\" type=\"textarea\" :rows=\"4\" placeholder=\"请输入评语\" />\n        </el-form-item>\n      </el-form>\n      <template #footer>\n        <el-button @click=\"reviewVisible = false\">取消</el-button>\n        <el-button type=\"primary\" :loading=\"reviewing\" @click=\"handleReview\">提交评价</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, onMounted } from 'vue'\nimport { receivedWeekly, weeklyDetail, reviewWeekly } from '@/api/weekly'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDate } from '@/utils/format'\nimport { WEEKLY_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(receivedWeekly, { state: '', current: 1, size: 10 })\n\nconst detailVisible = ref(false)\nconst reviewVisible = ref(false)\nconst reviewing = ref(false)\nconst current = ref(null)\nconst reviewForm = reactive({ reportId: null, score: 5, comment: '' })\n\nasync function showDetail(row) {\n  try {\n    current.value = await weeklyDetail(row.reportId)\n  } catch {\n    current.value = row\n  }\n  detailVisible.value = true\n}\n\nfunction openReview(row) {\n  reviewForm.reportId = row.reportId\n  reviewForm.score = 5\n  reviewForm.comment = ''\n  reviewVisible.value = true\n}\n\nasync function handleReview() {\n  if (!reviewForm.score) {\n    success('请选择评分')\n    return\n  }\n  reviewing.value = true\n  try {\n    await reviewWeekly({ ...reviewForm })\n    success('评价已提交')\n    reviewVisible.value = false\n    detailVisible.value = false\n    fetchList()\n  } finally {\n    reviewing.value = false\n  }\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\nh3 {\n  margin: 0 0 12px;\n}\nh4 {\n  margin: 12px 0 6px;\n  color: #409eff;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n</style>\n"],"mappings":"AA4GA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AAC7C,SAASC,cAAc,EAAEC,YAAY,EAAEC,YAAY,QAAQ,cAAa;AACxE,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,UAAU,Q