{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { receivedApplies, auditApply } from '@/api/apply';\nimport { myJobs } from '@/api/job';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDateTime } from '@/utils/format';\nimport { APPLY_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport { ElMessageBox } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport ResumePreview from '@/components/ResumePreview.vue';\nimport InterviewScheduleDialog from './components/InterviewScheduleDialog.vue';\nexport default {\n  __name: 'ApplyReceived',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const jobOptions = ref([]);\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(receivedApplies, {\n      jobId: null,\n      applyState: '',\n      current: 1,\n      size: 10\n    });\n    const resumeVisible = ref(false);\n    const scheduleVisible = ref(false);\n    const current = ref(null);\n    function showResume(row) {\n      current.value = row;\n      resumeVisible.value = true;\n    }\n    function openSchedule(row) {\n      current.value = row;\n      scheduleVisible.value = true;\n    }\n    async function handleAudit(row, state) {\n      const action = state === 'interview' ? '安排面试' : '淘汰';\n      try {\n        await ElMessageBox.confirm(`确定对「${row.studentName}」${action}吗？`, '提示', {\n          confirmButtonText: action,\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await auditApply({\n        applyId: row.applyId,\n        applyState: state\n      });\n      success(`${action}成功`);\n      if (state === 'interview') {\n        openSchedule(row);\n      }\n      fetchList();\n    }\n    function onScheduleSuccess() {\n      scheduleVisible.value = false;\n      fetchList();\n    }\n    onMounted(async () => {\n      try {\n        const data = await myJobs({\n          current: 1,\n          size: 100\n        });\n        jobOptions.value = data?.records || [];\n      } catch {\n        // 忽略\n      }\n      fetchList();\n    });\n    const __returned__ = {\n      jobOptions,\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      resumeVisible,\n      scheduleVisible,\n      current,\n      showResume,\n      openSchedule,\n      handleAudit,\n      onScheduleSuccess,\n      ref,\n      onMounted,\n      get receivedApplies() {\n        return receivedApplies;\n      },\n      get auditApply() {\n        return auditApply;\n      },\n      get myJobs() {\n        return myJobs;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get APPLY_STATE_MAP() {\n        return APPLY_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState,\n      ResumePreview,\n      InterviewScheduleDialog\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","receivedApplies","auditApply","myJobs","usePagination","formatDateTime","APPLY_STATE_MAP","success","ElMessageBox","PageHeader","StateBadge","EmptyState","ResumePreview","InterviewScheduleDialog","jobOptions","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","jobId","applyState","current","size","resumeVisible","scheduleVisible","showResume","row","value","openSchedule","handleAudit","state","action","confirm","studentName","confirmButtonText","cancelButtonText","type","applyId","onScheduleSuccess","data","records"],"sources":["F:/sxzp/project0/frontend/new/src/views/company/ApplyReceived.vue"],"sourcesContent":["<template>\n  <div class=\"apply-received\">\n    <PageHeader title=\"收到的投递\" desc=\"筛选并处理学生投递\" />\n\n    <div class=\"filter-bar\">\n      <el-select v-model=\"query.jobId\" placeholder=\"选择岗位\" clearable style=\"width: 220px\" @change=\"handleSearch\">\n        <el-option\n          v-for=\"j in jobOptions\"\n          :key=\"j.jobId\"\n          :label=\"j.jobTitle\"\n          :value=\"j.jobId\"\n        />\n      </el-select>\n      <el-radio-group v-model=\"query.applyState\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待处理</el-radio-button>\n        <el-radio-button label=\"interview\">进入面试</el-radio-button>\n        <el-radio-button label=\"rejected\">已淘汰</el-radio-button>\n        <el-radio-button label=\"passed\">已通过</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"studentName\" label=\"学生姓名\" min-width=\"100\" />\n        <el-table-column prop=\"studentNo\" label=\"学号\" width=\"120\" />\n        <el-table-column prop=\"college\" label=\"学院\" min-width=\"140\" />\n        <el-table-column prop=\"major\" label=\"专业\" min-width=\"140\" />\n        <el-table-column prop=\"jobTitle\" label=\"投递岗位\" min-width=\"160\" />\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.applyState\" :map=\"APPLY_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"投递时间\" width=\"160\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.applyTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"280\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"showResume(row)\">查看简历</el-button>\n            <el-button\n              v-if=\"row.applyState === 'pending'\"\n              size=\"small\"\n              type=\"success\"\n              @click=\"handleAudit(row, 'interview')\"\n            >\n              安排面试\n            </el-button>\n            <el-button\n              v-if=\"row.applyState === 'pending'\"\n              size=\"small\"\n              type=\"danger\"\n              @click=\"handleAudit(row, 'rejected')\"\n            >\n              淘汰\n            </el-button>\n            <el-button\n              v-if=\"row.applyState === 'interview'\"\n              size=\"small\"\n              type=\"primary\"\n              @click=\"openSchedule(row)\"\n            >\n              面试安排\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无投递记录\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <!-- 简历快照对话框 -->\n    <el-dialog v-model=\"resumeVisible\" title=\"简历内容\" width=\"640px\">\n      <ResumePreview\n        v-if=\"current && current.resumeSnapshot\"\n        :resume=\"{}\"\n        :snapshot=\"current.resumeSnapshot\"\n      />\n      <EmptyState v-else text=\"该投递无简历快照\" />\n      <template #footer>\n        <el-button @click=\"resumeVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n\n    <!-- 安排面试对话框 -->\n    <InterviewScheduleDialog\n      v-model=\"scheduleVisible\"\n      :apply-id=\"current?.applyId\"\n      @success=\"onScheduleSuccess\"\n    />\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { receivedApplies, auditApply } from '@/api/apply'\nimport { myJobs } from '@/api/job'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDateTime } from '@/utils/format'\nimport { APPLY_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport { ElMessageBox } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\nimport ResumePreview from '@/components/ResumePreview.vue'\nimport InterviewScheduleDialog from './components/InterviewScheduleDialog.vue'\n\nconst jobOptions = ref([])\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(receivedApplies, { jobId: null, applyState: '', current: 1, size: 10 })\n\nconst resumeVisible = ref(false)\nconst scheduleVisible = ref(false)\nconst current = ref(null)\n\nfunction showResume(row) {\n  current.value = row\n  resumeVisible.value = true\n}\n\nfunction openSchedule(row) {\n  current.value = row\n  scheduleVisible.value = true\n}\n\nasync function handleAudit(row, state) {\n  const action = state === 'interview' ? '安排面试' : '淘汰'\n  try {\n    await ElMessageBox.confirm(`确定对「${row.studentName}」${action}吗？`, '提示', {\n      confirmButtonText: action,\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await auditApply({ applyId: row.applyId, applyState: state })\n  success(`${action}成功`)\n  if (state === 'interview') {\n    openSchedule(row)\n  }\n  fetchList()\n}\n\nfunction onScheduleSuccess() {\n  scheduleVisible.value = false\n  fetchList()\n}\n\nonMounted(async () => {\n  try {\n    const data = await myJobs({ current: 1, size: 100 })\n    jobOptions.value = data?.records || []\n  } catch {\n    // 忽略\n  }\n  fetchList()\n})\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n</style>\n"],"mappings":"AA0GA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,eAAe,EAAEC,UAAU,QAAQ,aAAY;AACxD,SAASC,MAAM,QAAQ,WAAU;AACjC,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,cAAc,QAAQ,gBAAe;AAC9C,SAASC,eAAe,QAAQ,eAAc;AAC9C,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,QAAQ,cAAa;AAC1C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,aAAa,MAAM,gCAA+B;AACzD,OAAOC,uBAAuB,MAAM,0CAAyC;;;;;;;IAE7E,MAAMC,UAAU,GAAGf,GAAG,CAAC,EAAE;IAEzB,MAAM;MAAEgB,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGlB,aAAa,CAACH,eAAe,EAAE;MAAEsB,KAAK,EAAE,IAAI;MAAEC,UAAU,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAEtF,MAAMC,aAAa,GAAG5B,GAAG,CAAC,KAAK;IAC/B,MAAM6B,eAAe,GAAG7B,GAAG,CAAC,KAAK;IACjC,MAAM0B,OAAO,GAAG1B,GAAG,CAAC,IAAI;IAExB,SAAS8B,UAAUA,CAACC,GAAG,EAAE;MACvBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBH,aAAa,CAACI,KAAK,GAAG,IAAG;IAC3B;IAEA,SAASC,YAAYA,CAACF,GAAG,EAAE;MACzBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBF,eAAe,CAACG,KAAK,GAAG,IAAG;IAC7B;IAEA,eAAeE,WAAWA,CAACH,GAAG,EAAEI,KAAK,EAAE;MACrC,MAAMC,MAAM,GAAGD,KAAK,KAAK,WAAW,GAAG,MAAM,GAAG,IAAG;MACnD,IAAI;QACF,MAAM1B,YAAY,CAAC4B,OAAO,CAAC,OAAON,GAAG,CAACO,WAAW,IAAIF,MAAM,IAAI,EAAE,IAAI,EAAE;UACrEG,iBAAiB,EAAEH,MAAM;UACzBI,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;MACH,CAAC,CAAC,MAAM;QACN;MACF;MACA,MAAMtC,UAAU,CAAC;QAAEuC,OAAO,EAAEX,GAAG,CAACW,OAAO;QAAEjB,UAAU,EAAEU;MAAM,CAAC;MAC5D3B,OAAO,CAAC,GAAG4B,MAAM,IAAI;MACrB,IAAID,KAAK,KAAK,WAAW,EAAE;QACzBF,YAAY,CAACF,GAAG;MAClB;MACAX,SAAS,CAAC;IACZ;IAEA,SAASuB,iBAAiBA,CAAA,EAAG;MAC3Bd,eAAe,CAACG,KAAK,GAAG,KAAI;MAC5BZ,SAAS,CAAC;IACZ;IAEAnB,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAM2C,IAAI,GAAG,MAAMxC,MAAM,CAAC;UAAEsB,OAAO,EAAE,CAAC;UAAEC,IAAI,EAAE;QAAI,CAAC;QACnDZ,UA