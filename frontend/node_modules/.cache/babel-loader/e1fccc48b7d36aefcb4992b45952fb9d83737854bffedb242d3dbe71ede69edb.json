{"ast":null,"code":"import { onMounted } from 'vue';\nimport { myJobs, offlineJob, resubmitJob } from '@/api/job';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatMoney, formatDate } from '@/utils/format';\nimport { JOB_AUDIT_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport { ElMessageBox } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport DictTag from '@/components/DictTag.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'JobList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(myJobs, {\n      auditState: '',\n      current: 1,\n      size: 10\n    });\n    async function handleResubmit(row) {\n      await resubmitJob(row.jobId);\n      success('已提交审核');\n      fetchList();\n    }\n    async function handleOffline(row) {\n      try {\n        await ElMessageBox.confirm(`确定下线「${row.jobTitle}」吗？`, '提示', {\n          confirmButtonText: '下线',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await offlineJob(row.jobId);\n      success('岗位已下线');\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      handleResubmit,\n      handleOffline,\n      onMounted,\n      get myJobs() {\n        return myJobs;\n      },\n      get offlineJob() {\n        return offlineJob;\n      },\n      get resubmitJob() {\n        return resubmitJob;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatMoney() {\n        return formatMoney;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      get JOB_AUDIT_STATE_MAP() {\n        return JOB_AUDIT_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      PageHeader,\n      StateBadge,\n      DictTag,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["onMounted","myJobs","offlineJob","resubmitJob","usePagination","formatMoney","formatDate","JOB_AUDIT_STATE_MAP","success","ElMessageBox","PageHeader","StateBadge","DictTag","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","auditState","current","size","handleResubmit","row","jobId","handleOffline","confirm","jobTitle","confirmButtonText","cancelButtonText","type"],"sources":["F:/sxzp/project0/frontend/src/views/company/JobList.vue"],"sourcesContent":["<template>\n  <div class=\"job-list\">\n    <PageHeader title=\"我的岗位\" desc=\"管理已发布的实习岗位\">\n      <template #actions>\n        <el-button type=\"primary\" @click=\"$router.push('/company/jobs/edit')\">\n          <el-icon><Plus /></el-icon>发布岗位\n        </el-button>\n      </template>\n    </PageHeader>\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.auditState\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"draft\">草稿</el-radio-button>\n        <el-radio-button label=\"pending\">待审核</el-radio-button>\n        <el-radio-button label=\"online\">已上线</el-radio-button>\n        <el-radio-button label=\"reject\">已驳回</el-radio-button>\n        <el-radio-button label=\"ended\">已下线</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"jobTitle\" label=\"岗位名称\" min-width=\"200\" />\n        <el-table-column label=\"类型\" width=\"100\">\n          <template #default=\"{ row }\">\n            <DictTag type-code=\"job_type\" :code=\"row.jobType\" />\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"headcount\" label=\"招聘人数\" width=\"100\" />\n        <el-table-column prop=\"workPlace\" label=\"工作地\" width=\"120\" />\n        <el-table-column label=\"津贴\" width=\"100\">\n          <template #default=\"{ row }\">{{ formatMoney(row.benefitMoney) }}</template>\n        </el-table-column>\n        <el-table-column prop=\"applyCount\" label=\"投递数\" width=\"80\" />\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <el-tag\n              v-if=\"row.auditState === 'ended'\"\n              type=\"danger\"\n              effect=\"plain\"\n              size=\"small\"\n            >\n              已下线\n            </el-tag>\n            <StateBadge v-else :state=\"row.auditState\" :map=\"JOB_AUDIT_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"发布时间\" width=\"120\">\n          <template #default=\"{ row }\">{{ formatDate(row.publishTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"240\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"$router.push(`/company/jobs/edit?id=${row.jobId}`)\">\n              编辑\n            </el-button>\n            <el-button\n              v-if=\"row.auditState === 'reject'\"\n              size=\"small\"\n              type=\"warning\"\n              @click=\"handleResubmit(row)\"\n            >\n              重新提交\n            </el-button>\n            <el-button\n              v-if=\"row.auditState === 'online'\"\n              size=\"small\"\n              type=\"danger\"\n              @click=\"handleOffline(row)\"\n            >\n              下线\n            </el-button>\n            <el-button\n              v-if=\"row.auditState === 'ended'\"\n              size=\"small\"\n              type=\"primary\"\n              @click=\"handleResubmit(row)\"\n            >\n              发送审核\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"还没有发布岗位\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { onMounted } from 'vue'\nimport { myJobs, offlineJob, resubmitJob } from '@/api/job'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatMoney, formatDate } from '@/utils/format'\nimport { JOB_AUDIT_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport { ElMessageBox } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport DictTag from '@/components/DictTag.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(myJobs, { auditState: '', current: 1, size: 10 })\n\nasync function handleResubmit(row) {\n  await resubmitJob(row.jobId)\n  success('已提交审核')\n  fetchList()\n}\n\nasync function handleOffline(row) {\n  try {\n    await ElMessageBox.confirm(`确定下线「${row.jobTitle}」吗？`, '提示', {\n      confirmButtonText: '下线',\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await offlineJob(row.jobId)\n  success('岗位已下线')\n  fetchList()\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n</style>\n"],"mappings":"AAsGA,SAASA,SAAS,QAAQ,KAAI;AAC9B,SAASC,MAAM,EAAEC,UAAU,EAAEC,WAAW,QAAQ,WAAU;AAC1D,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,WAAW,EAAEC,UAAU,QAAQ,gBAAe;AACvD,SAASC,mBAAmB,QAAQ,eAAc;AAClD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,QAAQ,cAAa;AAC1C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,OAAO,MAAM,0BAAyB;AAC7C,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGjB,aAAa,CAACH,MAAM,EAAE;MAAEqB,UAAU,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAEhE,eAAeC,cAAcA,CAACC,GAAG,EAAE;MACjC,MAAMvB,WAAW,CAACuB,GAAG,CAACC,KAAK;MAC3BnB,OAAO,CAAC,OAAO;MACfU,SAAS,CAAC;IACZ;IAEA,eAAeU,aAAaA,CAACF,GAAG,EAAE;MAChC,IAAI;QACF,MAAMjB,YAAY,CAACoB,OAAO,CAAC,QAAQH,GAAG,CAACI,QAAQ,KAAK,EAAE,IAAI,EAAE;UAC1DC,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;MACH,CAAC,CAAC,MAAM;QACN;MACF;MACA,MAAM/B,UAAU,CAACwB,GAAG,CAACC,KAAK;MAC1BnB,OAAO,CAAC,OAAO;MACfU,SAAS,CAAC;IACZ;IAEAlB,SAAS,CAACkB,SAAS","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}