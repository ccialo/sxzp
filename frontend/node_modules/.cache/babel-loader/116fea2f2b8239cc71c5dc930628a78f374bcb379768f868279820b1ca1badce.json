{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { getProfile, saveProfile } from '@/api/company';\nimport { useDictStore } from '@/stores/dict';\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport FileUpload from '@/components/FileUpload.vue';\nexport default {\n  __name: 'CompanyProfile',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const dictStore = useDictStore();\n    const formRef = ref();\n    const loading = ref(false);\n    const saving = ref(false);\n    const categoryList = ref([]);\n    const form = reactive({\n      entName: '',\n      creditCode: '',\n      category: '',\n      contactName: '',\n      contactPhone: '',\n      contactEmail: '',\n      address: '',\n      intro: '',\n      certFile: '',\n      authState: '',\n      rejectReason: ''\n    });\n    const rules = {\n      entName: [{\n        required: true,\n        message: '请输入单位名称',\n        trigger: 'blur'\n      }]\n    };\n    async function loadProfile() {\n      loading.value = true;\n      try {\n        const data = await getProfile();\n        Object.assign(form, data || {});\n      } catch {\n        // 新企业可能还没档案，404 之类的由拦截器处理\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function handleSave() {\n      if (!formRef.value) return;\n      try {\n        await formRef.value.validate();\n      } catch {\n        return;\n      }\n      saving.value = true;\n      try {\n        await saveProfile({\n          ...form\n        });\n        success('保存成功，等待审核认证');\n        loadProfile();\n      } finally {\n        saving.value = false;\n      }\n    }\n    onMounted(async () => {\n      try {\n        categoryList.value = await dictStore.load('company_category');\n      } catch {\n        // 忽略\n      }\n      loadProfile();\n    });\n 