_STATE_MAP\" />\n          <span v-if=\"form.rejectReason\" class=\"reject-reason\">驳回理由：{{ form.rejectReason }}</span>\n        </el-form-item>\n        <el-form-item label=\"单位名称\" prop=\"entName\">\n          <el-input v-model=\"form.entName\" placeholder=\"请输入单位全称\" />\n        </el-form-item>\n        <el-form-item label=\"信用代码\" prop=\"creditCode\">\n          <el-input v-model=\"form.creditCode\" placeholder=\"统一社会信用代码\" />\n        </el-form-item>\n        <el-form-item label=\"单位性质\" prop=\"category\">\n          <el-select v-model=\"form.category\" placeholder=\"请选择\" clearable style=\"width: 100%\">\n            <el-option\n              v-for=\"d in categoryList\"\n              :key=\"d.dictCode\"\n              :label=\"d.dictLabel\"\n              :value=\"d.dictCode\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"联系人\" prop=\"contactName\">\n          <el-input v-model=\"form.contactName\" placeholder=\"请输入联系人\" />\n        </el-form-item>\n        <el-form-item label=\"联系电话\" prop=\"contactPhone\">\n          <el-input v-model=\"form.contactPhone\" placeholder=\"请输入联系电话\" />\n        </el-form-item>\n        <el-form-item label=\"联系邮箱\" prop=\"contactEmail\">\n          <el-input v-model=\"form.contactEmail\" placeholder=\"请输入联系邮箱\" />\n        </el-form-item>\n        <el-form-item label=\"单位地址\" prop=\"address\">\n          <el-input v-model=\"form.address\" placeholder=\"请输入单位地址\" />\n        </el-form-item>\n        <el-form-item label=\"企业简介\" prop=\"intro\">\n          <el-input v-model=\"form.intro\" type=\"textarea\" :rows=\"4\" placeholder=\"请输入企业简介\" />\n        </el-form-item>\n        <el-form-item label=\"资质文件\" prop=\"certFile\">\n          <FileUpload v-model=\"form.certFile\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" :loading=\"saving\" @click=\"handleSave\">保存</el-button>\n          <el-button @click=\"loadProfile\">重置</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, onMounted } from 'vue'\nimport { getProfile, saveProfile } from '@/api/company'\nimport { useDictStore } from '@/stores/dict'\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport FileUpload from '@/components/FileUpload.vue'\n\nconst dictStore = useDictStore()\nconst formRef = ref()\nconst loading = ref(false)\nconst saving = ref(false)\nconst categoryList = ref([])\n\nconst form = reactive({\n  entName: '',\n  creditCode: '',\n  category: '',\n  contactName: '',\n  contactPhone: '',\n  contactEmail: '',\n  address: '',\n  intro: '',\n  certFile: '',\n  authState: '',\n  rejectReason: '',\n})\n\nconst rules = {\n  entName: [{ required: true, message: '请输入单位名称', trigger: 'blur' }],\n}\n\nasync function loadProfile() {\n  loading.value = true\n  try {\n    const data = await getProfile()\n    Object.assign(form, data || {})\n  } catch {\n    // 新企业可能还没档案，404 之类的由拦截器处理\n  } finally {\n    loading.value = false\n  }\n}\n\nasync function handleSave() {\n  if (!formRef.value) return\n  try {\n    await formRef.value.validate()\n  } catch {\n    return\n  }\n  saving.value = true\n  try {\n    await saveProfile({ ...form })\n    success('保存成功，等待审核认证')\n    loadProfile()\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(async () => {\n  try {\n    categoryList.value = await dictStore.load('company_category')\n  } catch {\n    // 忽略\n  }\n  loadProfile()\n})\n</script>\n\n<style scoped>\n.reject-reason {\n  margin-left: 12px;\n  color: #f56c6c;\n  font-size: 12px;\n}\n</style>\n"],"mappings":"AAiEA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AAC7C,SAASC,UAAU,EAAEC,WAAW,QAAQ,eAAc;AACtD,SAASC,YAAY,QAAQ,eAAc;AAC3C,SAASC,sBAAsB,QAAQ,eAAc;AACrD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6B