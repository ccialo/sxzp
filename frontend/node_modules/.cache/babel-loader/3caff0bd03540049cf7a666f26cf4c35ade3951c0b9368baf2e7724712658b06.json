{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useAuthStore } from '@/stores/auth';\nimport { jobDetail } from '@/api/job';\nimport { formatMoney, formatDate } from '@/utils/format';\nimport PageHeader from '@/components/PageHeader.vue';\nimport DictTag from '@/components/DictTag.vue';\nexport default {\n  __name: 'JobDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const authStore = useAuthStore();\n    const job = ref(null);\n    const loading = ref(false);\n    function goSearch() {\n      router.push('/jobs');\n    }\n    async function load() {\n      const id = route.params.id;\n      loading.value = true;\n      try {\n        job.value = await jobDetail(id);\n      } finally {\n        loading.value = false;\n      }\n    }\n    onMounted(load);\n    const __returned__ = {\n      route,\n      router,\n      authStore,\n      job,\n      loading,\n      goSearch,\n      load,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get useAuthStore() {\n        return useAuthStore;\n      },\n      get jobDetail() {\n        return jobDetail;\n      },\n      get formatMoney() {\n        return formatMoney;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      PageHeader,\n      DictTag\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","useRouter","useAuthStore","jobDetail","formatMoney","formatDate","PageHeader","DictTag","route","router","authStore","job","loading","goSearch","push","load","id","params","value"],"sources":["F:/sxzp/project0/frontend/src/views/public/JobDetail.vue"],"sourcesContent":["<template>\n  <div v-loading=\"loading\" class=\"job-detail\">\n    <PageHeader>\n      <template #title>\n        <span>{{ job?.jobTitle }}</span>\n      </template>\n      <template #actions>\n        <el-button @click=\"$router.back()\">返回</el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-if=\"job\" class=\"info-card\">\n      <div class=\"job-title-row\">\n        <h2>{{ job.jobTitle }}</h2>\n        <el-tag v-if=\"job.auditState === 'online'\" type=\"success\" size=\"large\">在招</el-tag>\n      </div>\n      <div class=\"salary\">{{ formatMoney(job.benefitMoney) }} / 月</div>\n\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <el-icon><OfficeBuilding /></el-icon>\n          <router-link :to=\"`/companies/${job.companyId}`\">{{ job.companyName }}</router-link>\n          <el-tag v-if=\"job.companyAuthState === 'auth'\" type=\"success\" size=\"small\">已认证</el-tag>\n        </div>\n        <div class=\"info-item\">\n          <el-icon><Briefcase /></el-icon>\n          <DictTag type-code=\"job_type\" :code=\"job.jobType\" />\n        </div>\n        <div class=\"info-item\">\n          <el-icon><Location /></el-icon>\n          <span>{{ job.workPlace || '不限' }}</span>\n        </div>\n        <div v-if=\"job.category\" class=\"info-item\">\n          <el-icon><Collection /></el-icon>\n          <el-tag size=\"small\">{{ job.category }}</el-tag>\n        </div>\n        <div class=\"info-item\">\n          <el-icon><User /></el-icon>\n          <span>招聘 {{ job.headcount }} 人</span>\n        </div>\n        <div class=\"info-item\">\n          <el-icon><Calendar /></el-icon>\n          <span>{{ formatDate(job.startDate) }} ~ {{ formatDate(job.endDate) }}</span>\n        </div>\n      </div>\n\n      <el-divider />\n\n      <h3>岗位职责</h3>\n      <pre class=\"content-pre\">{{ job.duty || '暂无' }}</pre>\n\n      <h3>任职要求</h3>\n      <pre class=\"content-pre\">{{ job.req || '暂无' }}</pre>\n\n      <div class=\"apply-actions\">\n        <el-button\n          v-if=\"authStore.isLoggedIn && authStore.userType === 'student'\"\n          size=\"large\"\n          :type=\"job.applied ? 'info' : 'primary'\"\n          :disabled=\"job.applied\"\n          @click=\"goSearch\"\n        >\n          {{ job.applied ? '已投递' : '前往岗位检索页投递' }}\n        </el-button>\n        <el-button v-if=\"!authStore.isLoggedIn\" type=\"primary\" size=\"large\" @click=\"$router.push('/login')\">\n          登录后投递\n        </el-button>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { useRoute, useRouter } from 'vue-router'\nimport { useAuthStore } from '@/stores/auth'\nimport { jobDetail } from '@/api/job'\nimport { formatMoney, formatDate } from '@/utils/format'\nimport PageHeader from '@/components/PageHeader.vue'\nimport DictTag from '@/components/DictTag.vue'\n\nconst route = useRoute()\nconst router = useRouter()\nconst authStore = useAuthStore()\n\nconst job = ref(null)\nconst loading = ref(false)\n\nfunction goSearch() {\n  router.push('/jobs')\n}\n\nasync function load() {\n  const id = route.params.id\n  loading.value = true\n  try {\n    job.value = await jobDetail(id)\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(load)\n</script>\n\n<style scoped>\n.job-detail {\n  min-height: 400px;\n}\n.info-card {\n  padding: 4px;\n}\n.job-title-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.job-title-row h2 {\n  margin: 0;\n  font-size: 22px;\n  color: #303133;\n}\n.salary {\n  margin: 12px 0;\n  font-size: 20px;\n  font-weight: 600;\n  color: #f56c6c;\n}\n.info-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 12px;\n}\n.info-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #606266;\n}\nh3 {\n  margin: 16px 0 8px;\n  font-size: 16px;\n  color: #303133;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n.apply-actions {\n  margin-top: 32px;\n  text-align: center;\n}\n</style>\n"],"mappings":";AAyEA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAW;AAC/C,SAASC,YAAY,QAAQ,eAAc;AAC3C,SAASC,SAAS,QAAQ,WAAU;AACpC,SAASC,WAAW,EAAEC,UAAU,QAAQ,gBAAe;AACvD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,OAAO,MAAM,0BAAyB;;;;;;;IAE7C,MAAMC,KAAK,GAAGR,QAAQ,CAAC;IACvB,MAAMS,MAAM,GAAGR,SAAS,CAAC;IACzB,MAAMS,SAAS,GAAGR,YAAY,CAAC;IAE/B,MAAMS,GAAG,GAAGb,GAAG,CAAC,IAAI;IACpB,MAAMc,OAAO,GAAGd,GAAG,CAAC,KAAK;IAEzB,SAASe,QAAQA,CAAA,EAAG;MAClBJ,MAAM,CAACK,IAAI,CAAC,OAAO;IACrB;IAEA,eAAeC,IAAIA,CAAA,EAAG;MACpB,MAAMC,EAAE,GAAGR,KAAK,CAACS,MAAM,CAACD,EAAC;MACzBJ,OAAO,CAACM,KAAK,GAAG,IAAG;MACnB,IAAI;QACFP,GAAG,CAACO,KAAK,GAAG,MAAMf,SAAS,CAACa,EAAE;MAChC,CAAC,SAAS;QACRJ,OAAO,CAACM,KAAK,GAAG,KAAI;MACtB;IACF;IAEAnB,SAAS,CAACgB,IAAI","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}