{"ast":null,"code":"import { myApplies } from '@/api/apply';\nimport { withdrawApply } from '@/api/apply';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDateTime } from '@/utils/format';\nimport { APPLY_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport { ElMessageBox } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport { onMounted } from 'vue';\nexport default {\n  __name: 'ApplyList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(myApplies, {\n      applyState: '',\n      current: 1,\n      size: 10\n    });\n    async function handleWithdraw(row) {\n      try {\n        await ElMessageBox.confirm(`确定撤回「${row.jobTitle}」的投递吗？`, '提示', {\n          confirmButtonText: '撤回',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await withdrawApply(row.applyId);\n      success('已撤回投递');\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      handleWithdraw,\n      get myApplies() {\n        return myApplies;\n      },\n      get withdrawApply() {\n        return withdrawApply;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get APPLY_STATE_MAP() {\n        return APPLY_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState,\n      onMounted\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["myApplies","withdrawApply","usePagination","formatDateTime","APPLY_STATE_MAP","success","ElMessageBox","PageHeader","StateBadge","EmptyState","onMounted","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","applyState","current","size","handleWithdraw","row","confirm","jobTitle","confirmButtonText","cancelButtonText","type","applyId"],"sources":["F:/sxzp/project0/frontend/src/views/student/ApplyList.vue"],"sourcesContent":["<template>\n  <div class=\"apply-list\">\n    <PageHeader title=\"我的投递\" desc=\"查看投递记录和状态进展\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.applyState\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待处理</el-radio-button>\n        <el-radio-button label=\"interview\">进入面试</el-radio-button>\n        <el-radio-button label=\"rejected\">未通过</el-radio-button>\n        <el-radio-button label=\"passed\">已通过</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column label=\"岗位\" min-width=\"200\">\n          <template #default=\"{ row }\">\n            <router-link :to=\"`/jobs/${row.jobId}`\">{{ row.jobTitle }}</router-link>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"companyName\" label=\"企业\" min-width=\"160\" />\n        <el-table-column prop=\"workPlace\" label=\"工作地\" width=\"120\" />\n        <el-table-column label=\"状态\" width=\"120\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.applyState\" :map=\"APPLY_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"投递时间\" width=\"180\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.applyTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button\n              v-if=\"row.applyState === 'pending'\"\n              size=\"small\"\n              type=\"warning\"\n              @click=\"handleWithdraw(row)\"\n            >\n              撤回\n            </el-button>\n            <el-button\n              v-if=\"row.applyState === 'interview'\"\n              size=\"small\"\n              type=\"primary\"\n              @click=\"$router.push('/student/interviews')\"\n            >\n              查看面试\n            </el-button>\n            <el-button size=\"small\" @click=\"$router.push(`/jobs/${row.jobId}`)\">\n              岗位详情\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"还没有投递记录\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { myApplies } from '@/api/apply'\nimport { withdrawApply } from '@/api/apply'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDateTime } from '@/utils/format'\nimport { APPLY_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport { ElMessageBox } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(myApplies, { applyState: '', current: 1, size: 10 })\n\nasync function handleWithdraw(row) {\n  try {\n    await ElMessageBox.confirm(`确定撤回「${row.jobTitle}」的投递吗？`, '提示', {\n      confirmButtonText: '撤回',\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await withdrawApply(row.applyId)\n  success('已撤回投递')\n  fetchList()\n}\n\nimport { onMounted } from 'vue'\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n</style>\n"],"mappings":"AA0EA,SAASA,SAAS,QAAQ,aAAY;AACtC,SAASC,aAAa,QAAQ,aAAY;AAC1C,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,cAAc,QAAQ,gBAAe;AAC9C,SAASC,eAAe,QAAQ,eAAc;AAC9C,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,QAAQ,cAAa;AAC1C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AAoBnD,SAASC,SAAS,QAAQ,KAAI;;;;;;;IAlB9B,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGhB,aAAa,CAACF,SAAS,EAAE;MAAEmB,UAAU,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAEnE,eAAeC,cAAcA,CAACC,GAAG,EAAE;MACjC,IAAI;QACF,MAAMjB,YAAY,CAACkB,OAAO,CAAC,QAAQD,GAAG,CAACE,QAAQ,QAAQ,EAAE,IAAI,EAAE;UAC7DC,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;MACH,CAAC,CAAC,MAAM;QACN;MACF;MACA,MAAM3B,aAAa,CAACsB,GAAG,CAACM,OAAO;MAC/BxB,OAAO,CAAC,OAAO;MACfU,SAAS,CAAC;IACZ;IAGAL,SAAS,CAACK,SAAS","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}