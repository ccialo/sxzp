{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { submitWeekly } from '@/api/weekly';\nimport { myApplies } from '@/api/apply';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  __name: 'WeeklySubmit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const formRef = ref();\n    const loading = ref(false);\n    const saving = ref(false);\n    const applyList = ref([]);\n    const form = reactive({\n      applyId: route.query.applyId ? Number(route.query.applyId) : null,\n      weekNum: 1,\n      startDate: '',\n      endDate: '',\n      content: '',\n      plan: '',\n      problem: ''\n    });\n    const rules = {\n      applyId: [{\n        required: true,\n        message: '请选择投递记录',\n        trigger: 'change'\n      }],\n      weekNum: [{\n        required: true,\n        message: '请输入周次',\n        trigger: 'blur'\n      }]\n    };\n    function onApplyChange() {\n      // 预设时间：默认本周一到周日\n      const today = new Date();\n      const day = today.getDay() || 7;\n      const monday = new Date(today);\n      monday.setDate(today.getDate() - day + 1);\n      const sunday = new Date(monday);\n      sunday.setDate(monday.getDate() + 6);\n      if (!form.startDate) {\n        form.startDate = monday.toISOString().slice(0, 10);\n      }\n      if (!form.endDate) {\n        form.endDate = sunday.toISOString().slice(0, 10);\n      }\n    }\n    async function loadApplies() {\n      loading.value = true;\n      try {\n        const data = await myApplies({\n          current: 1,\n          size: 100,\n          applyState: 'passed'\n        });\n        applyList.value = data?.records || [];\n        // 没有 passed 的也展示 interview 状态\n        if (!applyList.value.length) {\n          const data2 = await myApplies({\n            current: 1,\n            size: 100,\n            applyState: 'interview'\n          });\n          applyList.value = data2?.records || [];\n        }\n        if (form.applyId) onApplyChange();\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function handleSubmit() {\n      if (!formRef.value) return;\n      try {\n        await formRef.value.validate();\n      } catch {\n        return;\n      }\n      saving.value = true;\n      try {\n        await submitWeekly({\n          ...form\n        });\n        success('周报已提交');\n        router.push('/student/weekly');\n      } finally {\n        saving.value = false;\n      }\n    }\n    onMounted(loadApplies);\n    const __returned__ = {\n      route,\n      router,\n      formRef,\n      loading,\n      saving,\n      applyList,\n      form,\n      rules,\n      onApplyChange,\n      loadApplies,\n      handleSubmit,\n      ref,\n      reactive,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get submitWeekly() {\n        return submitWeekly;\n      },\n      get myApplies() {\n        return myApplies;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","useRoute","useRouter","submitWeekly","myApplies","success","PageHeader","route","router","formRef","loading","saving","applyList","form","applyId","query","Number","weekNum","startDate","endDate","content","plan","problem","rules","required","message","trigger","onApplyChange","today","Date","day","getDay","monday","setDate","getDate","sunday","toISOString","slice","loadApplies","value","data","current","size","applyState","records","length","data2","handleSubmit","validate","push"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/WeeklySubmit.vue"],"sourcesContent":["<template>\n  <div class=\"weekly-submit\">\n    <PageHeader title=\"提交周报\" desc=\"记录本周实习工作内容与企业评价\">\n      <template #actions>\n        <el-button @click=\"$router.back()\">返回</el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-width=\"100px\" size=\"default\">\n        <el-form-item label=\"关联投递\" prop=\"applyId\">\n          <el-select v-model=\"form.applyId\" placeholder=\"选择已通过的投递\" style=\"width: 100%\" @change=\"onApplyChange\">\n            <el-option\n              v-for=\"a in applyList\"\n              :key=\"a.applyId\"\n              :label=\"`${a.jobTitle} - ${a.companyName}`\"\n              :value=\"a.applyId\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"周次\" prop=\"weekNum\">\n          <el-input-number v-model=\"form.weekNum\" :min=\"1\" :max=\"52\" />\n        </el-form-item>\n        <el-row :gutter=\"12\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"本周开始\" prop=\"startDate\">\n              <el-date-picker v-model=\"form.startDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"选择开始日期\" style=\"width: 100%\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item label=\"本周结束\" prop=\"endDate\">\n              <el-date-picker v-model=\"form.endDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"选择结束日期\" style=\"width: 100%\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-form-item label=\"本周内容\" prop=\"content\">\n          <el-input v-model=\"form.content\" type=\"textarea\" :rows=\"6\" placeholder=\"请输入本周工作内容\" />\n        </el-form-item>\n        <el-form-item label=\"下周计划\" prop=\"plan\">\n          <el-input v-model=\"form.plan\" type=\"textarea\" :rows=\"4\" placeholder=\"请输入下周工作计划\" />\n        </el-form-item>\n        <el-form-item label=\"遇到的问题\" prop=\"problem\">\n          <el-input v-model=\"form.problem\" type=\"textarea\" :rows=\"4\" placeholder=\"遇到的问题与解决方案\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" :loading=\"saving\" @click=\"handleSubmit\">提交周报</el-button>\n          <el-button @click=\"$router.back()\">取消</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, onMounted } from 'vue'\nimport { useRoute, useRouter } from 'vue-router'\nimport { submitWeekly } from '@/api/weekly'\nimport { myApplies } from '@/api/apply'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\n\nconst route = useRoute()\nconst router = useRouter()\n\nconst formRef = ref()\nconst loading = ref(false)\nconst saving = ref(false)\nconst applyList = ref([])\n\nconst form = reactive({\n  applyId: route.query.applyId ? Number(route.query.applyId) : null,\n  weekNum: 1,\n  startDate: '',\n  endDate: '',\n  content: '',\n  plan: '',\n  problem: '',\n})\n\nconst rules = {\n  applyId: [{ required: true, message: '请选择投递记录', trigger: 'change' }],\n  weekNum: [{ required: true, message: '请输入周次', trigger: 'blur' }],\n}\n\nfunction onApplyChange() {\n  // 预设时间：默认本周一到周日\n  const today = new Date()\n  const day = today.getDay() || 7\n  const monday = new Date(today)\n  monday.setDate(today.getDate() - day + 1)\n  const sunday = new Date(monday)\n  sunday.setDate(monday.getDate() + 6)\n  if (!form.startDate) {\n    form.startDate = monday.toISOString().slice(0, 10)\n  }\n  if (!form.endDate) {\n    form.endDate = sunday.toISOString().slice(0, 10)\n  }\n}\n\nasync function loadApplies() {\n  loading.value = true\n  try {\n    const data = await myApplies({ current: 1, size: 100, applyState: 'passed' })\n    applyList.value = data?.records || []\n    // 没有 passed 的也展示 interview 状态\n    if (!applyList.value.length) {\n      const data2 = await myApplies({ current: 1, size: 100, applyState: 'interview' })\n      applyList.value = data2?.records || []\n    }\n    if (form.applyId) onApplyChange()\n  } finally {\n    loading.value = false\n  }\n}\n\nasync function handleSubmit() {\n  if (!formRef.value) return\n  try {\n    await formRef.value.validate()\n  } catch {\n    return\n  }\n  saving.value = true\n  try {\n    await submitWeekly({ ...form })\n    success('周报已提交')\n    router.push('/student/weekly')\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(loadApplies)\n</script>\n"],"mappings":";AAsDA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AAC7C,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAW;AAC/C,SAASC,YAAY,QAAQ,cAAa;AAC1C,SAASC,SAAS,QAAQ,aAAY;AACtC,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAMC,KAAK,GAAGN,QAAQ,CAAC;IACvB,MAAMO,MAAM,GAAGN,SAAS,CAAC;IAEzB,MAAMO,OAAO,GAAGX,GAAG,CAAC;IACpB,MAAMY,OAAO,GAAGZ,GAAG,CAAC,KAAK;IACzB,MAAMa,MAAM,GAAGb,GAAG,CAAC,KAAK;IACxB,MAAMc,SAAS,GAAGd,GAAG,CAAC,EAAE;IAExB,MAAMe,IAAI,GAAGd,QAAQ,CAAC;MACpBe,OAAO,EAAEP,KAAK,CAACQ,KAAK,CAACD,OAAO,GAAGE,MAAM,CAACT,KAAK,CAACQ,KAAK,CAACD,OAAO,CAAC,GAAG,IAAI;MACjEG,OAAO,EAAE,CAAC;MACVC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,OAAO,EAAE,EAAE;MACXC,IAAI,EAAE,EAAE;MACRC,OAAO,EAAE;IACX,CAAC;IAED,MAAMC,KAAK,GAAG;MACZT,OAAO,EAAE,CAAC;QAAEU,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,SAAS;QAAEC,OAAO,EAAE;MAAS,CAAC,CAAC;MACpET,OAAO,EAAE,CAAC;QAAEO,QAAQ,EAAE,IAAI;QAAEC,OAAO,EAAE,OAAO;QAAEC,OAAO,EAAE;MAAO,CAAC;IACjE;IAEA,SAASC,aAAaA,CAAA,EAAG;MACvB;MACA,MAAMC,KAAK,GAAG,IAAIC,IAAI,CAAC;MACvB,MAAMC,GAAG,GAAGF,KAAK,CAACG,MAAM,CAAC,CAAC,IAAI;MAC9B,MAAMC,MAAM,GAAG,IAAIH,IAAI,CAACD,KAAK;MAC7BI,MAAM,CAACC,OAAO,CAACL,KAAK,CAACM,OAAO,CAAC,CAAC,GAAGJ,GAAG,GAAG,CAAC;MACxC,MAAMK,MAAM,GAAG,IAAIN,IAAI,CAACG,MAAM;MAC9BG,MAAM,CAACF,OAAO,CAACD,MAAM,CAACE,OAAO,CAAC,CAAC,GAAG,CAAC;MACnC,IAAI,CAACrB,IAAI,CAACK,SAAS,EAAE;QACnBL,IAAI,CAACK,SAAS,GAAGc,