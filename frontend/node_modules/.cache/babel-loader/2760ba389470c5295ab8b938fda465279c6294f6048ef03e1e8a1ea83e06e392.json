{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { myAgreements, signAgreement, rejectAgreement } from '@/api/agreement';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDate, formatMoney } from '@/utils/format';\nimport { AGREEMENT_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport { ElMessageBox } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'AgreementList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(myAgreements, {\n      state: '',\n      current: 1,\n      size: 10\n    });\n    const contentVisible = ref(false);\n    const current = ref(null);\n    function showContent(row) {\n      current.value = row;\n      contentVisible.value = true;\n    }\n    async function handleSign(row) {\n      try {\n        await ElMessageBox.confirm('确定签署该实习协议吗？', '提示', {\n          confirmButtonText: '确认签署',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await signAgreement(row.agreementId);\n      success('协议已签署');\n      contentVisible.value = false;\n      fetchList();\n    }\n    async function handleReject(row) {\n      try {\n        await ElMessageBox.confirm('确定拒绝该协议吗？此操作不可撤销', '提示', {\n          confirmButtonText: '拒绝',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await rejectAgreement(row.agreementId);\n      success('已拒绝协议');\n      contentVisible.value = false;\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      contentVisible,\n      current,\n      showContent,\n      handleSign,\n      handleReject,\n      ref,\n      onMounted,\n      get myAgreements() {\n        return myAgreements;\n      },\n      get signAgreement() {\n        return signAgreement;\n      },\n      get rejectAgreement() {\n        return rejectAgreement;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      get formatMoney() {\n        return formatMoney;\n      },\n      get AGREEMENT_STATE_MAP() {\n        return AGREEMENT_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","myAgreements","signAgreement","rejectAgreement","usePagination","formatDate","formatMoney","AGREEMENT_STATE_MAP","success","ElMessageBox","PageHeader","StateBadge","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","state","current","size","contentVisible","showContent","row","value","handleSign","confirm","confirmButtonText","cancelButtonText","type","agreementId","handleReject"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/AgreementList.vue"],"sourcesContent":["<template>\n  <div class=\"agreement-list\">\n    <PageHeader title=\"我的协议\" desc=\"查看和签署实习协议\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.state\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待签署</el-radio-button>\n        <el-radio-button label=\"signed\">已签署</el-radio-button>\n        <el-radio-button label=\"rejected\">已拒绝</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"jobTitle\" label=\"岗位\" min-width=\"160\" />\n        <el-table-column prop=\"companyName\" label=\"企业\" min-width=\"140\" />\n        <el-table-column label=\"实习期\" min-width=\"200\">\n          <template #default=\"{ row }\">\n            {{ formatDate(row.startDate) }} ~ {{ formatDate(row.endDate) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"津贴\" width=\"120\">\n          <template #default=\"{ row }\">{{ formatMoney(row.salary) }}</template>\n        </el-table-column>\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.state\" :map=\"AGREEMENT_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"240\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"showContent(row)\">查看内容</el-button>\n            <el-button\n              v-if=\"row.state === 'pending'\"\n              size=\"small\"\n              type=\"success\"\n              @click=\"handleSign(row)\"\n            >\n              签署\n            </el-button>\n            <el-button\n              v-if=\"row.state === 'pending'\"\n              size=\"small\"\n              type=\"danger\"\n              @click=\"handleReject(row)\"\n            >\n              拒绝\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无协议记录\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <el-dialog v-model=\"contentVisible\" title=\"协议内容\" width=\"640px\">\n      <pre class=\"content-pre\">{{ current?.content || '暂无内容' }}</pre>\n      <template #footer>\n        <el-button v-if=\"current?.state === 'pending'\" type=\"success\" @click=\"handleSign(current)\">\n          同意并签署\n        </el-button>\n        <el-button v-if=\"current?.state === 'pending'\" type=\"danger\" @click=\"handleReject(current)\">\n          拒绝\n        </el-button>\n        <el-button @click=\"contentVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { myAgreements, signAgreement, rejectAgreement } from '@/api/agreement'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDate, formatMoney } from '@/utils/format'\nimport { AGREEMENT_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport { ElMessageBox } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(myAgreements, { state: '', current: 1, size: 10 })\n\nconst contentVisible = ref(false)\nconst current = ref(null)\n\nfunction showContent(row) {\n  current.value = row\n  contentVisible.value = true\n}\n\nasync function handleSign(row) {\n  try {\n    await ElMessageBox.confirm('确定签署该实习协议吗？', '提示', {\n      confirmButtonText: '确认签署',\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await signAgreement(row.agreementId)\n  success('协议已签署')\n  contentVisible.value = false\n  fetchList()\n}\n\nasync function handleReject(row) {\n  try {\n    await ElMessageBox.confirm('确定拒绝该协议吗？此操作不可撤销', '提示', {\n      confirmButtonText: '拒绝',\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await rejectAgreement(row.agreementId)\n  success('已拒绝协议')\n  contentVisible.value = false\n  fetchList()\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #303133;\n  font-family: inherit;\n  max-height: 400px;\n  overflow-y: auto;\n}\n</style>\n"],"mappings":"AAoFA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,YAAY,EAAEC,aAAa,EAAEC,eAAe,QAAQ,iBAAgB;AAC7E,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,UAAU,EAAEC,WAAW,QAAQ,gBAAe;AACvD,SAASC,mBAAmB,QAAQ,eAAc;AAClD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,QAAQ,cAAa;AAC1C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGhB,aAAa,CAACH,YAAY,EAAE;MAAEoB,KAAK,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAEjE,MAAMC,cAAc,GAAGzB,GAAG,CAAC,KAAK;IAChC,MAAMuB,OAAO,GAAGvB,GAAG,CAAC,IAAI;IAExB,SAAS0B,WAAWA,CAACC,GAAG,EAAE;MACxBJ,OAAO,CAACK,KAAK,GAAGD,GAAE;MAClBF,cAAc,CAACG,KAAK,GAAG,IAAG;IAC5B;IAEA,eAAeC,UAAUA,CAACF,GAAG,EAAE;MAC7B,IAAI;QACF,MAAMjB,YAAY,CAACoB,OAAO,CAAC,aAAa,EAAE,IAAI,EAAE;UAC9CC,iBAAiB,EAAE,MAAM;UACzBC,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;MACH,CAAC,CAAC,MAAM;QACN;MACF;MACA,MAAM9B,aAAa,CAACwB,GAAG,CAACO,WAAW;MACnCzB,OAAO,CAAC,OAAO;MACfgB,cAAc,CAACG,KAAK,GAAG,KAAI;MAC3BV,SAAS,CAAC;IACZ;IAEA,eAAeiB,YAAYA,CAACR,GAAG,EAAE;MAC/B,IAAI;QACF,MAAMjB,YAAY,CAACoB,OAAO,CAAC,kBAAkB,EAAE,IAAI,EAAE;UACnDC,iBAAiB,EAAE,IAAI;UACvBC,gBAAgB,EAAE,IAAI;UACtBC,IAAI,EAAE;QACR,CAAC;MACH,CAAC