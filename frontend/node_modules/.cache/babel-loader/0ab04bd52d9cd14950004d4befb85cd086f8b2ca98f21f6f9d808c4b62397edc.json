{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { myWeekly, weeklyDetail } from '@/api/weekly';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDate } from '@/utils/format';\nimport { WEEKLY_STATE_MAP } from '@/utils/enums';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'WeeklyList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange\n    } = usePagination(myWeekly, {\n      current: 1,\n      size: 10\n    });\n    const detailVisible = ref(false);\n    const current = ref(null);\n    function goSubmit() {\n      router.push('/student/weekly/submit');\n    }\n    async function showDetail(row) {\n      try {\n        current.value = await weeklyDetail(row.reportId);\n      } catch {\n        current.value = row;\n      }\n      detailVisible.value = true;\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      router,\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      detailVisible,\n      current,\n      goSubmit,\n      showDetail,\n      ref,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      get myWeekly() {\n        return myWeekly;\n      },\n      get weeklyDetail() {\n        return weeklyDetail;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      get WEEKLY_STATE_MAP() {\n        return WEEKLY_STATE_MAP;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRouter","myWeekly","weeklyDetail","usePagination","formatDate","WEEKLY_STATE_MAP","PageHeader","StateBadge","EmptyState","router","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","current","size","detailVisible","goSubmit","push","showDetail","row","value","reportId"],"sources":["F:/sxzp/project0/frontend/src/views/student/WeeklyList.vue"],"sourcesContent":["<template>\n  <div class=\"weekly-list\">\n    <PageHeader title=\"我的周报\" desc=\"回顾实习周报与企业评价\">\n      <template #actions>\n        <el-button type=\"primary\" @click=\"goSubmit\">\n          <el-icon><Plus /></el-icon>提交周报\n        </el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column label=\"周次\" width=\"80\">\n          <template #default=\"{ row }\">第 {{ row.weekNum }} 周</template>\n        </el-table-column>\n        <el-table-column label=\"本周时间\" min-width=\"200\">\n          <template #default=\"{ row }\">\n            {{ formatDate(row.startDate) }} ~ {{ formatDate(row.endDate) }}\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"jobTitle\" label=\"岗位\" min-width=\"140\" />\n        <el-table-column prop=\"companyName\" label=\"企业\" min-width=\"140\" />\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.state\" :map=\"WEEKLY_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"企业评分\" width=\"140\">\n          <template #default=\"{ row }\">\n            <el-rate v-if=\"row.reviewScore\" v-model=\"row.reviewScore\" disabled />\n            <span v-else>-</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"showDetail(row)\">查看详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"还没有提交过周报\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <el-dialog v-model=\"detailVisible\" title=\"周报详情\" width=\"640px\">\n      <template v-if=\"current\">\n        <h3>第 {{ current.weekNum }} 周（{{ formatDate(current.startDate) }} ~ {{ formatDate(current.endDate) }}）</h3>\n        <h4>本周工作内容</h4>\n        <pre class=\"content-pre\">{{ current.content || '暂无' }}</pre>\n        <h4>下周计划</h4>\n        <pre class=\"content-pre\">{{ current.plan || '暂无' }}</pre>\n        <h4>遇到的问题</h4>\n        <pre class=\"content-pre\">{{ current.problem || '暂无' }}</pre>\n        <template v-if=\"current.state === 'reviewed'\">\n          <h4>企业评价</h4>\n          <el-rate v-model=\"current.reviewScore\" disabled />\n          <pre class=\"content-pre\">{{ current.reviewComment || '暂无评语' }}</pre>\n        </template>\n      </template>\n      <template #footer>\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { myWeekly, weeklyDetail } from '@/api/weekly'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDate } from '@/utils/format'\nimport { WEEKLY_STATE_MAP } from '@/utils/enums'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst router = useRouter()\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange } =\n  usePagination(myWeekly, { current: 1, size: 10 })\n\nconst detailVisible = ref(false)\nconst current = ref(null)\n\nfunction goSubmit() {\n  router.push('/student/weekly/submit')\n}\n\nasync function showDetail(row) {\n  try {\n    current.value = await weeklyDetail(row.reportId)\n  } catch {\n    current.value = row\n  }\n  detailVisible.value = true\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\nh3 {\n  margin: 0 0 12px;\n}\nh4 {\n  margin: 12px 0 6px;\n  color: #409eff;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n</style>\n"],"mappings":";AA8EA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,SAAS,QAAQ,YAAW;AACrC,SAASC,QAAQ,EAAEC,YAAY,QAAQ,cAAa;AACpD,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,UAAU,QAAQ,gBAAe;AAC1C,SAASC,gBAAgB,QAAQ,eAAc;AAC/C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAMC,MAAM,GAAGT,SAAS,CAAC;IAEzB,MAAM;MAAEU,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC;IAAiB,CAAC,GAClFb,aAAa,CAACF,QAAQ,EAAE;MAAEgB,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAElD,MAAMC,aAAa,GAAGrB,GAAG,CAAC,KAAK;IAC/B,MAAMmB,OAAO,GAAGnB,GAAG,CAAC,IAAI;IAExB,SAASsB,QAAQA,CAAA,EAAG;MAClBX,MAAM,CAACY,IAAI,CAAC,wBAAwB;IACtC;IAEA,eAAeC,UAAUA,CAACC,GAAG,EAAE;MAC7B,IAAI;QACFN,OAAO,CAACO,KAAK,GAAG,MAAMtB,YAAY,CAACqB,GAAG,CAACE,QAAQ;MACjD,CAAC,CAAC,MAAM;QACNR,OAAO,CAACO,KAAK,GAAGD,GAAE;MACpB;MACAJ,aAAa,CAACK,KAAK,GAAG,IAAG;IAC3B;IAEAzB,SAAS,CAACe,SAAS","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}