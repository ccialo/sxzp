{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, watch, onMounted } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useAuthStore } from '@/stores/auth';\nimport { useDictStore } from '@/stores/dict';\nimport { getHomeRoute } from '@/permission';\nimport { success } from '@/utils/message';\nexport default {\n  __name: 'Register',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const authStore = useAuthStore();\n    const dictStore = useDictStore();\n    const formRef = ref();\n    const loading = ref(false);\n    const categoryList = ref([]);\n    const form = reactive({\n      account: '',\n      password: '',\n      userType: 'student',\n      realName: '',\n      email: '',\n      phone: '',\n      // 学生\n      studentNo: '',\n      college: '',\n      major: '',\n      gradeYear: '',\n      // 企业\n      entName: '',\n      creditCode: '',\n      category: '',\n      address: ''\n    });\n    const rules = {\n      account: [{\n        required: true,\n        message: '请输入账号',\n        trigger: 'blur'\n      }, {\n        min: 4,\n        max: 40,\n        message: '账号长度 4-40',\n        trigger: 'blur'\n      }],\n      password: [{\n        required: true,\n        message: '请输入密码',\n        trigger: 'blur'\n      }, {\n        min: 6,\n        max: 32,\n        message: '密码长度 6-32',\n        trigger: 'blur'\n      }],\n      realName: [{\n        required: true,\n        message: '请输入真实姓名',\n        trigger: 'blur'\n      }],\n      entName: [{\n        required: true,\n        message: '请输入单位名称',\n        trigger: 'blur'\n      }]\n    };\n    watch(() => form.userType, () => {\n      formRef.value?.clearValidate();\n    });\n    onMounted(async () => {\n      try {\n        categoryList.value = await dictStore.load('company_category');\n      } catch {\n        // 忽略\n      }\n    });\n    async function handleRegister() {\n      if (!formRef.value) return;\n      try {\n        await formRef.value.validate();\n      } catch {\n        return;\n      }\n      loading.value = true;\n      try {\n        await authStore.register({\n          ...form\n        });\n        success('注册成功');\n        router.push(getHomeRoute(authStore.userType));\n      } catch {\n        // 拦截器已弹错误\n      } finally {\n        loading.value = false;\n      }\n    }\n    const __returned__ = {\n      router,\n      authStore,\n      dictStore,\n      formRef,\n      loading,\n      categoryList,\n      form,\n      rules,\n      handleRegister,\n      ref,\n      reactive,\n      watch,\n      onMounted,\n      get useRouter() {\n        return useRouter;\n      },\n      get useAuthStore() {\n        return useAuthStore;\n      },\n      get useDictStore() {\n        return useDictStore;\n      },\n      get getHomeRoute() {\n        return getHomeRoute;\n      },\n      get success() {\n        return success;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","watch","onMounted","useRouter","useAuthStore","useDictStore","getHomeRoute","success","router","authStore","dictStore","formRef","loading","categoryList","form","account","password","userType","realName","email","phone","studentNo","college","major","gradeYear","entName","creditCode","category","address","rules","required","message","trigger","min","max","value","clearValidate","load","handleRegister","validate","register","push"],"sources":["F:/sxzp/project0/frontend/src/views/public/Register.vue"],"sourcesContent":["<template>\n  <div class=\"register-page\">\n    <div class=\"register-card\">\n      <div class=\"register-header\">\n        <h1>注册账号</h1>\n        <p>选择身份并填写信息，开启你的招聘之旅</p>\n      </div>\n      <el-radio-group v-model=\"form.userType\" size=\"large\" class=\"role-switch\">\n        <el-radio-button label=\"student\">学生注册</el-radio-button>\n        <el-radio-button label=\"company\">企业注册</el-radio-button>\n      </el-radio-group>\n      <el-form\n        ref=\"formRef\"\n        :model=\"form\"\n        :rules=\"rules\"\n        label-width=\"100px\"\n        size=\"default\"\n        class=\"register-form\"\n      >\n        <el-divider content-position=\"left\">账号信息</el-divider>\n        <el-form-item label=\"登录账号\" prop=\"account\">\n          <el-input v-model=\"form.account\" placeholder=\"学生用学号，企业用自定义账号\" />\n        </el-form-item>\n        <el-form-item label=\"登录密码\" prop=\"password\">\n          <el-input v-model=\"form.password\" type=\"password\" placeholder=\"6-32 位\" show-password />\n        </el-form-item>\n        <el-form-item label=\"真实姓名\" prop=\"realName\">\n          <el-input v-model=\"form.realName\" placeholder=\"请输入真实姓名\" />\n        </el-form-item>\n        <el-form-item label=\"邮箱\" prop=\"email\">\n          <el-input v-model=\"form.email\" placeholder=\"选填\" />\n        </el-form-item>\n        <el-form-item label=\"手机号\" prop=\"phone\">\n          <el-input v-model=\"form.phone\" placeholder=\"选填\" />\n        </el-form-item>\n\n        <template v-if=\"form.userType === 'student'\">\n          <el-divider content-position=\"left\">学生信息</el-divider>\n          <el-form-item label=\"学号\" prop=\"studentNo\">\n            <el-input v-model=\"form.studentNo\" placeholder=\"请输入学号\" />\n          </el-form-item>\n          <el-form-item label=\"学院\" prop=\"college\">\n            <el-input v-model=\"form.college\" placeholder=\"请输入学院\" />\n          </el-form-item>\n          <el-form-item label=\"专业\" prop=\"major\">\n            <el-input v-model=\"form.major\" placeholder=\"请输入专业\" />\n          </el-form-item>\n          <el-form-item label=\"毕业年份\" prop=\"gradeYear\">\n            <el-input v-model=\"form.gradeYear\" placeholder=\"如 2026\" />\n          </el-form-item>\n        </template>\n\n        <template v-else>\n          <el-divider content-position=\"left\">企业信息</el-divider>\n          <el-form-item label=\"单位名称\" prop=\"entName\">\n            <el-input v-model=\"form.entName\" placeholder=\"请输入单位全称\" />\n          </el-form-item>\n          <el-form-item label=\"信用代码\" prop=\"creditCode\">\n            <el-input v-model=\"form.creditCode\" placeholder=\"统一社会信用代码\" />\n          </el-form-item>\n          <el-form-item label=\"单位性质\" prop=\"category\">\n            <el-select v-model=\"form.category\" placeholder=\"请选择\" clearable style=\"width: 100%\">\n              <el-option\n                v-for=\"d in categoryList\"\n                :key=\"d.dictCode\"\n                :label=\"d.dictLabel\"\n                :value=\"d.dictCode\"\n              />\n            </el-select>\n          </el-form-item>\n          <el-form-item label=\"单位地址\" prop=\"address\">\n            <el-input v-model=\"form.address\" placeholder=\"请输入单位地址\" />\n          </el-form-item>\n        </template>\n\n        <el-form-item>\n          <el-button type=\"primary\" class=\"submit-btn\" :loading=\"loading\" @click=\"handleRegister\">\n            立即注册\n          </el-button>\n        </el-form-item>\n      </el-form>\n      <div class=\"register-footer\">\n        已有账号？<router-link to=\"/login\">直接登录</router-link>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, watch, onMounted } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { useAuthStore } from '@/stores/auth'\nimport { useDictStore } from '@/stores/dict'\nimport { getHomeRoute } from '@/permission'\nimport { success } from '@/utils/message'\n\nconst router = useRouter()\nconst authStore = useAuthStore()\nconst dictStore = useDictStore()\n\nconst formRef = ref()\nconst loading = ref(false)\nconst categoryList = ref([])\n\nconst form = reactive({\n  account: '',\n  password: '',\n  userType: 'student',\n  realName: '',\n  email: '',\n  phone: '',\n  // 学生\n  studentNo: '',\n  college: '',\n  major: '',\n  gradeYear: '',\n  // 企业\n  entName: '',\n  creditCode: '',\n  category: '',\n  address: '',\n})\n\nconst rules = {\n  account: [\n    { required: true, message: '请输入账号', trigger: 'blur' },\n    { min: 4, max: 40, message: '账号长度 4-40', trigger: 'blur' },\n  ],\n  password: [\n    { required: true, message: '请输入密码', trigger: 'blur' },\n    { min: 6, max: 32, message: '密码长度 6-32', trigger: 'blur' },\n  ],\n  realName: [{ required: true, message: '请输入真实姓名', trigger: 'blur' }],\n  entName: [{ required: true, message: '请输入单位名称', trigger: 'blur' }],\n}\n\nwatch(\n  () => form.userType,\n  () => {\n    formRef.value?.clearValidate()\n  }\n)\n\nonMounted(async () => {\n  try {\n    categoryList.value = await dictStore.load('company_category')\n  } catch {\n    // 忽略\n  }\n})\n\nasync function handleRegister() {\n  if (!formRef.value) return\n  try {\n    await formRef.value.validate()\n  } catch {\n    return\n  }\n  loading.value = true\n  try {\n    await authStore.register({ ...form })\n    success('注册成功')\n    router.push(getHomeRoute(authStore.userType))\n  } catch {\n    // 拦截器已弹错误\n  } finally {\n    loading.value = false\n  }\n}\n</script>\n\n<style scoped>\n.register-page {\n  width: 100%;\n  max-width: 640px;\n  padding: 20px 0;\n  margin: 0 auto;\n}\n.register-card {\n  background: #fff;\n  border-radius: 12px;\n  padding: 32px 40px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);\n}\n.register-header {\n  text-align: center;\n  margin-bottom: 16px;\n}\n.register-header h1 {\n  margin: 0 0 4px;\n  font-size: 22px;\n  color: #303133;\n}\n.register-header p {\n  margin: 0;\n  font-size: 13px;\n  color: #909399;\n}\n.role-switch {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 16px;\n}\n.register-form {\n  margin-top: 8px;\n}\n.submit-btn {\n  width: 100%;\n}\n.register-footer {\n  text-align: center;\n  margin-top: 16px;\n  font-size: 13px;\n  color: #909399;\n}\n</style>\n"],"mappings":";AAyFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,KAAK,EAAEC,SAA