{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { pageCompanies, auditCompany } from '@/api/company';\nimport { usePagination } from '@/composables/usePagination';\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport DictTag from '@/components/DictTag.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport AuditDialog from '@/components/AuditDialog.vue';\nimport FilePreview from '@/components/FilePreview.vue';\nexport default {\n  __name: 'CompanyAudit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(pageCompanies, {\n      authState: 'pending',\n      keyword: '',\n      current: 1,\n      size: 10\n    });\n    const auditVisible = ref(false);\n    const detailVisible = ref(false);\n    const current = ref(null);\n    function openAudit(row) {\n      current.value = row;\n      auditVisible.value = true;\n    }\n    function showDetail(row) {\n      current.value = row;\n      detailVisible.value = true;\n    }\n    async function handleAudit(form) {\n      if (!current.value) return;\n      await auditCompany({\n        companyId: current.value.companyId,\n        pass: form.pass,\n        opinion: form.opinion\n      });\n      success(form.pass ? '审核通过' : '已驳回');\n      auditVisible.value = false;\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      auditVisible,\n      detailVisible,\n      current,\n      openAudit,\n      showDetail,\n      handleAudit,\n      ref,\n      onMounted,\n      get pageCompanies() {\n        return pageCompanies;\n      },\n      get auditCompany() {\n        return auditCompany;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get COMPANY_AUTH_STATE_MAP() {\n        return COMPANY_AUTH_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader,\n      StateBadge,\n      DictTag,\n      EmptyState,\n      AuditDialog,\n      FilePreview\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","pageCompanies","auditCompany","usePagination","COMPANY_AUTH_STATE_MAP","success","PageHeader","StateBadge","DictTag","EmptyState","AuditDialog","FilePreview","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","authState","keyword","current","size","auditVisible","detailVisible","openAudit","row","value","showDetail","handleAudit","form","companyId","pass","opinion"],"sources":["F:/sxzp/project0/frontend/src/views/admin/CompanyAudit.vue"],"sourcesContent":["<template>\n  <div class=\"company-audit\">\n    <PageHeader title=\"企业审核\" desc=\"审核企业认证申请\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.authState\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待审核</el-radio-button>\n        <el-radio-button label=\"auth\">已认证</el-radio-button>\n        <el-radio-button label=\"reject\">未通过</el-radio-button>\n        <el-radio-button label=\"freeze\">已冻结</el-radio-button>\n      </el-radio-group>\n      <el-input\n        v-model=\"query.keyword\"\n        placeholder=\"企业名称 / 信用代码\"\n        clearable\n        style=\"width: 240px\"\n        @keyup.enter=\"handleSearch\"\n      />\n      <el-button type=\"primary\" @click=\"handleSearch\">查询</el-button>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"entName\" label=\"单位名称\" min-width=\"200\" />\n        <el-table-column prop=\"creditCode\" label=\"信用代码\" width=\"200\" />\n        <el-table-column label=\"单位性质\" width=\"120\">\n          <template #default=\"{ row }\">\n            <DictTag type-code=\"company_category\" :code=\"row.category\" />\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"contactName\" label=\"联系人\" width=\"100\" />\n        <el-table-column prop=\"contactPhone\" label=\"联系电话\" width=\"140\" />\n        <el-table-column label=\"认证状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.authState\" :map=\"COMPANY_AUTH_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"rejectReason\" label=\"驳回理由\" min-width=\"160\" />\n        <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button\n              v-if=\"row.authState === 'pending'\"\n              size=\"small\"\n              type=\"primary\"\n              @click=\"openAudit(row)\"\n            >\n              审核\n            </el-button>\n            <el-button v-else size=\"small\" @click=\"showDetail(row)\">查看</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无待审核企业\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <AuditDialog\n      v-model=\"auditVisible\"\n      title=\"审核企业认证\"\n      @confirm=\"handleAudit\"\n    />\n\n    <el-dialog v-model=\"detailVisible\" title=\"企业详情\" width=\"640px\">\n      <template v-if=\"current\">\n        <p><strong>单位名称：</strong>{{ current.entName }}</p>\n        <p><strong>信用代码：</strong>{{ current.creditCode }}</p>\n        <p><strong>联系人：</strong>{{ current.contactName }}</p>\n        <p><strong>联系电话：</strong>{{ current.contactPhone }}</p>\n        <p><strong>联系邮箱：</strong>{{ current.contactEmail }}</p>\n        <p><strong>单位地址：</strong>{{ current.address }}</p>\n        <p><strong>企业简介：</strong></p>\n        <pre class=\"content-pre\">{{ current.intro || '暂无' }}</pre>\n        <p v-if=\"current.certFile\"><strong>资质文件：</strong></p>\n        <FilePreview v-if=\"current.certFile\" :path=\"current.certFile\" />\n      </template>\n      <template #footer>\n        <el-button @click=\"detailVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { pageCompanies, auditCompany } from '@/api/company'\nimport { usePagination } from '@/composables/usePagination'\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport DictTag from '@/components/DictTag.vue'\nimport EmptyState from '@/components/EmptyState.vue'\nimport AuditDialog from '@/components/AuditDialog.vue'\nimport FilePreview from '@/components/FilePreview.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(pageCompanies, { authState: 'pending', keyword: '', current: 1, size: 10 })\n\nconst auditVisible = ref(false)\nconst detailVisible = ref(false)\nconst current = ref(null)\n\nfunction openAudit(row) {\n  current.value = row\n  auditVisible.value = true\n}\n\nfunction showDetail(row) {\n  current.value = row\n  detailVisible.value = true\n}\n\nasync function handleAudit(form) {\n  if (!current.value) return\n  await auditCompany({\n    companyId: current.value.companyId,\n    pass: form.pass,\n    opinion: form.opinion,\n  })\n  success(form.pass ? '审核通过' : '已驳回')\n  auditVisible.value = false\n  fetchList()\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n.content-pre {\n  margin: 0 0 16px;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n</style>\n"],"mappings":"AAgGA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,aAAa,EAAEC,YAAY,QAAQ,eAAc;AAC1D,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,sBAAsB,QAAQ,eAAc;AACrD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,OAAO,MAAM,0BAAyB;AAC7C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,WAAW,MAAM,8BAA6B;AACrD,OAAOC,WAAW,MAAM,8BAA6B;;;;;;;IAErD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGhB,aAAa,CAACF,aAAa,EAAE;MAAEmB,SAAS,EAAE,SAAS;MAAEC,OAAO,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAE1F,MAAMC,YAAY,GAAGzB,GAAG,CAAC,KAAK;IAC9B,MAAM0B,aAAa,GAAG1B,GAAG,CAAC,KAAK;IAC/B,MAAMuB,OAAO,GAAGvB,GAAG,CAAC,IAAI;IAExB,SAAS2B,SAASA,CAACC,GAAG,EAAE;MACtBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBH,YAAY,CAACI,KAAK,GAAG,IAAG;IAC1B;IAEA,SAASC,UAAUA,CAACF,GAAG,EAAE;MACvBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBF,aAAa,CAACG,KAAK,GAAG,IAAG;IAC3B;IAEA,eAAeE,WAAWA,CAACC,IAAI,EAAE;MAC/B,IAAI,CAACT,OAAO,CAACM,KAAK,EAAE;MACpB,MAAM1B,YAAY,CAAC;QACjB8B,SAAS,EAAEV,OAAO,CAACM,KAAK,CAACI,SAAS;QAClCC,IAAI,EAAEF,IAAI,CAACE,IAAI;QACfC,OAAO,EAAEH,IAAI,CAACG;MAChB,CAAC;MACD7B,OAAO,CAAC0B,IAAI,CAACE,IAAI,GAAG,MAAM,GAAG,KAAK;MAClCT,YAAY,CAACI,KAAK,GAAG,KAAI;MACzBZ,SAAS,CAAC;IACZ;IAEAhB,SAAS,CAACgB,SAAS","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}