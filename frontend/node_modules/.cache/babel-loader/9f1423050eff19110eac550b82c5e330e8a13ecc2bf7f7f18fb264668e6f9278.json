{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { listNotices, readNotice, readAllNotices } from '@/api/notice';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDateTime } from '@/utils/format';\nimport { NOTICE_TYPE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'NoticeList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(listNotices, {\n      type: '',\n      current: 1,\n      size: 10\n    });\n    const contentVisible = ref(false);\n    const current = ref(null);\n    async function handleRowClick(row) {\n      current.value = row;\n      contentVisible.value = true;\n      if (!row.isRead) {\n        await readNotice(row.noticeId);\n        row.isRead = 1;\n      }\n    }\n    async function handleRead(row) {\n      await readNotice(row.noticeId);\n      row.isRead = 1;\n      success('已标记已读');\n    }\n    async function handleReadAll() {\n      await readAllNotices();\n      success('已全部标记已读');\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      contentVisible,\n      current,\n      handleRowClick,\n      handleRead,\n      handleReadAll,\n      ref,\n      onMounted,\n      get listNotices() {\n        return listNotices;\n      },\n      get readNotice() {\n        return readNotice;\n      },\n      get readAllNotices() {\n        return readAllNotices;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get NOTICE_TYPE_MAP() {\n        return NOTICE_TYPE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","listNotices","readNotice","readAllNotices","usePagination","formatDateTime","NOTICE_TYPE_MAP","success","PageHeader","StateBadge","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","type","current","size","contentVisible","handleRowClick","row","value","isRead","noticeId","handleRead","handleReadAll"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/NoticeList.vue"],"sourcesContent":["<template>\n  <div class=\"notice-list\">\n    <PageHeader title=\"消息通知\" desc=\"站内消息，实时掌握进展\">\n      <template #actions>\n        <el-button type=\"primary\" @click=\"handleReadAll\">全部已读</el-button>\n      </template>\n    </PageHeader>\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.type\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"system\">系统</el-radio-button>\n        <el-radio-button label=\"apply\">投递</el-radio-button>\n        <el-radio-button label=\"interview\">面试</el-radio-button>\n        <el-radio-button label=\"agreement\">协议</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border @row-click=\"handleRowClick\">\n        <el-table-column label=\"\" width=\"50\">\n          <template #default=\"{ row }\">\n            <el-badge v-if=\"!row.isRead\" is-dot />\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"title\" label=\"标题\" min-width=\"200\" />\n        <el-table-column label=\"类型\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.type\" :map=\"NOTICE_TYPE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"状态\" width=\"80\">\n          <template #default=\"{ row }\">\n            <el-tag :type=\"row.isRead ? 'info' : 'danger'\" size=\"small\">\n              {{ row.isRead ? '已读' : '未读' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"时间\" width=\"180\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.createTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button v-if=\"!row.isRead\" size=\"small\" @click.stop=\"handleRead(row)\">标记已读</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无消息\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <el-dialog v-model=\"contentVisible\" :title=\"current?.title\" width=\"500px\">\n      <p class=\"content\">{{ current?.content }}</p>\n      <template #footer>\n        <el-button @click=\"contentVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { listNotices, readNotice, readAllNotices } from '@/api/notice'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDateTime } from '@/utils/format'\nimport { NOTICE_TYPE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(listNotices, { type: '', current: 1, size: 10 })\n\nconst contentVisible = ref(false)\nconst current = ref(null)\n\nasync function handleRowClick(row) {\n  current.value = row\n  contentVisible.value = true\n  if (!row.isRead) {\n    await readNotice(row.noticeId)\n    row.isRead = 1\n  }\n}\n\nasync function handleRead(row) {\n  await readNotice(row.noticeId)\n  row.isRead = 1\n  success('已标记已读')\n}\n\nasync function handleReadAll() {\n  await readAllNotices()\n  success('已全部标记已读')\n  fetchList()\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n.content {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #303133;\n}\n</style>\n"],"mappings":"AAyEA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,WAAW,EAAEC,UAAU,EAAEC,cAAc,QAAQ,cAAa;AACrE,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,cAAc,QAAQ,gBAAe;AAC9C,SAASC,eAAe,QAAQ,eAAc;AAC9C,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGd,aAAa,CAACH,WAAW,EAAE;MAAEkB,IAAI,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAE/D,MAAMC,cAAc,GAAGvB,GAAG,CAAC,KAAK;IAChC,MAAMqB,OAAO,GAAGrB,GAAG,CAAC,IAAI;IAExB,eAAewB,cAAcA,CAACC,GAAG,EAAE;MACjCJ,OAAO,CAACK,KAAK,GAAGD,GAAE;MAClBF,cAAc,CAACG,KAAK,GAAG,IAAG;MAC1B,IAAI,CAACD,GAAG,CAACE,MAAM,EAAE;QACf,MAAMxB,UAAU,CAACsB,GAAG,CAACG,QAAQ;QAC7BH,GAAG,CAACE,MAAM,GAAG;MACf;IACF;IAEA,eAAeE,UAAUA,CAACJ,G