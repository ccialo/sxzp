{"ast":null,"code":"import { formatMoney, formatDateTime } from '@/utils/format';\nimport DictTag from './DictTag.vue';\nexport default {\n  __name: 'JobCard',\n  props: {\n    job: {\n      type: Object,\n      required: true\n    }\n  },\n  emits: ['click'],\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const __returned__ = {\n      get formatMoney() {\n        return formatMoney;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      DictTag\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["formatMoney","formatDateTime","DictTag"],"sources":["F:/sxzp/project0/frontend/new/src/components/JobCard.vue"],"sourcesContent":["<template>\n  <el-card class=\"job-card\" shadow=\"hover\" :body-style=\"{ padding: '20px' }\">\n    <div class=\"card-header\" @click=\"$emit('click')\">\n      <div class=\"title-row\">\n        <h3 class=\"job-title\">{{ job.jobTitle }}</h3>\n        <el-tag v-if=\"job.auditState === 'online'\" type=\"success\" size=\"small\">在招</el-tag>\n      </div>\n      <div class=\"company\">\n        <el-icon><OfficeBuilding /></el-icon>\n        <router-link :to=\"`/companies/${job.companyId}`\" class=\"company-link\">\n          {{ job.companyName }}\n        </router-link>\n        <el-tag v-if=\"job.companyAuthState === 'auth'\" type=\"success\" size=\"small\">已认证</el-tag>\n      </div>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"info-row\">\n        <el-icon><Briefcase /></el-icon>\n        <DictTag type-code=\"job_type\" :code=\"job.jobType\" />\n      </div>\n      <div class=\"info-row\">\n        <el-icon><Location /></el-icon>\n        <span>{{ job.workPlace || '不限' }}</span>\n      </div>\n      <div class=\"info-row\">\n        <el-icon><Money /></el-icon>\n        <span class=\"salary\">{{ formatMoney(job.benefitMoney) }} / 月</span>\n      </div>\n      <div v-if=\"job.category\" class=\"info-row\">\n        <el-icon><Collection /></el-icon>\n        <el-tag size=\"small\">{{ job.category }}</el-tag>\n      </div>\n    </div>\n    <div class=\"card-footer\">\n      <span class=\"publish-time\">发布于 {{ formatDateTime(job.publishTime, 'YYYY-MM-DD') }}</span>\n      <div class=\"actions\">\n        <slot name=\"actions\" />\n      </div>\n    </div>\n  </el-card>\n</template>\n\n<script setup>\nimport { formatMoney, formatDateTime } from '@/utils/format'\nimport DictTag from './DictTag.vue'\n\ndefineProps({\n  job: { type: Object, required: true },\n})\ndefineEmits(['click'])\n</script>\n\n<style scoped>\n.job-card {\n  cursor: pointer;\n  transition: transform 0.2s;\n}\n.job-card:hover {\n  transform: translateY(-2px);\n}\n.card-header {\n  margin-bottom: 12px;\n}\n.title-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 4px;\n}\n.job-title {\n  margin: 0;\n  font-size: 16px;\n  color: #303133;\n  cursor: pointer;\n}\n.job-title:hover {\n  color: #409eff;\n}\n.company {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 13px;\n  color: #606266;\n}\n.company-link {\n  color: #606266;\n}\n.company-link:hover {\n  color: #409eff;\n}\n.card-body {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  font-size: 13px;\n  color: #606266;\n}\n.info-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.salary {\n  color: #f56c6c;\n  font-weight: 600;\n}\n.card-footer {\n  margin-top: 12px;\n  padding-top: 12px;\n  border-top: 1px dashed #ebeef5;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.publish-time {\n  font-size: 12px;\n  color: #909399;\n}\n.actions {\n  display: flex;\n  gap: 8px;\n}\n</style>\n"],"mappings":"AA2CA,SAASA,WAAW,EAAEC,cAAc,QAAQ,gBAAe;AAC3D,OAAOC,OAAO,MAAM,eAAc","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}