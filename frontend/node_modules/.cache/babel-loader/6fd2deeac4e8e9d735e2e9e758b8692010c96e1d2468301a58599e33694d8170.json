{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, computed, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { saveResume, resumeDetail } from '@/api/resume';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  __name: 'ResumeEdit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const formRef = ref();\n    const loading = ref(false);\n    const saving = ref(false);\n    const isEdit = computed(() => !!route.query.id);\n    const form = reactive({\n      resumeId: null,\n      title: '',\n      isPublic: 1,\n      isDefault: 0,\n      eduJson: '',\n      skill: '',\n      projectExp: '',\n      selfEval: '',\n      cont: ''\n    });\n    const eduList = ref([]);\n    const rules = {\n      title: [{\n        required: true,\n        message: '请输入简历名称',\n        trigger: 'blur'\n      }]\n    };\n    function addEdu() {\n      eduList.value.push({\n        school: '',\n        major: '',\n        degree: '',\n        startDate: '',\n        endDate: ''\n      });\n    }\n    function removeEdu(idx) {\n      eduList.value.splice(idx, 1);\n    }\n    async function loadDetail() {\n      const id = route.query.id;\n      if (!id) return;\n      loading.value = true;\n      try {\n        const data = await resumeDetail(id);\n        Object.assign(form, data);\n        if (data.eduJson) {\n          try {\n            eduList.value = JSON.parse(data.eduJson);\n          } catch {\n            eduList.value = [];\n          }\n        }\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function handleSave() {\n      if (!formRef.value) return;\n      try {\n        await formRef.value.validate();\n      } catch {\n        return;\n      }\n      saving.value = true;\n      try {\n        form.eduJson = JSON.stringify(eduList.value);\n        await saveResume({\n          ...form\n        });\n        success('保存成功');\n        router.push('/student/resumes');\n      } finally {\n        saving.value = false;\n      }\n    }\n    onMounted(loadDetail);\n    const __returned__ = {\n      route,\n      router,\n      formRef,\n      loading,\n      saving,\n      isEdit,\n      form,\n      eduList,\n      rules,\n      addEdu,\n      removeEdu,\n      loadDetail,\n      handleSave,\n      ref,\n      reactive,\n      computed,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get saveResume() {\n        return saveResume;\n      },\n      get resumeDetail() {\n        return resumeDetail;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","computed","onMounted","useRoute","useRouter","saveResume","resumeDetail","success","PageHeader","route","router","formRef","loading","saving","isEdit","query","id","form","resumeId","title","isPublic","isDefault","eduJson","skill","projectExp","selfEval","cont","eduList","rules","required","message","trigger","addEdu","value","push","school","major","degree","startDate","endDate","removeEdu","idx","splice","loadDetail","data","Object","assign","JSON","parse","handleSave","validate","stringify"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/ResumeEdit.vue"],"sourcesContent":["<template>\n  <div class=\"resume-edit\">\n    <PageHeader :title=\"isEdit ? '编辑简历' : '新建简历'\">\n      <template #actions>\n        <el-button @click=\"$router.back()\">返回</el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-form ref=\"formRef\" :model=\"form\" :rules=\"rules\" label-width=\"100px\" size=\"default\">\n        <el-form-item label=\"简历名称\" prop=\"title\">\n          <el-input v-model=\"form.title\" placeholder=\"如：软件工程-张同学\" style=\"max-width: 400px\" />\n        </el-form-item>\n        <el-form-item label=\"是否公开\">\n          <el-switch v-model=\"form.isPublic\" :active-value=\"1\" :inactive-value=\"0\" active-text=\"允许企业浏览\" />\n        </el-form-item>\n        <el-form-item label=\"设为默认\">\n          <el-switch v-model=\"form.isDefault\" :active-value=\"1\" :inactive-value=\"0\" active-text=\"设为默认投递简历\" />\n        </el-form-item>\n\n        <el-divider content-position=\"left\">教育经历</el-divider>\n        <div v-for=\"(edu, idx) in eduList\" :key=\"idx\" class=\"edu-item\">\n          <el-row :gutter=\"12\">\n            <el-col :span=\"6\">\n              <el-form-item label=\"学校\">\n                <el-input v-model=\"edu.school\" placeholder=\"请输入学校\" />\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-form-item label=\"专业\">\n                <el-input v-model=\"edu.major\" placeholder=\"请输入专业\" />\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"4\">\n              <el-form-item label=\"学历\">\n                <el-select v-model=\"edu.degree\" placeholder=\"请选择\">\n                  <el-option label=\"专科\" value=\"college\" />\n                  <el-option label=\"本科\" value=\"bachelor\" />\n                  <el-option label=\"硕士\" value=\"master\" />\n                  <el-option label=\"博士\" value=\"doctor\" />\n                </el-select>\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"3\">\n              <el-form-item label=\"开始\">\n                <el-date-picker v-model=\"edu.startDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"开始日期\" style=\"width: 100%\" />\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"3\">\n              <el-form-item label=\"结束\">\n                <el-date-picker v-model=\"edu.endDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"结束日期\" style=\"width: 100%\" />\n              </el-form-item>\n            </el-col>\n            <el-col :span=\"2\">\n              <el-button text type=\"danger\" @click=\"removeEdu(idx)\">\n                <el-icon><Delete /></el-icon>\n              </el-button>\n            </el-col>\n          </el-row>\n        </div>\n        <el-button text type=\"primary\" @click=\"addEdu\">\n          <el-icon><Plus /></el-icon>添加教育经历\n        </el-button>\n\n        <el-divider content-position=\"left\">其他信息</el-divider>\n        <el-form-item label=\"技能与证书\">\n          <el-input v-model=\"form.skill\" type=\"textarea\" :rows=\"3\" placeholder=\"如：Java / Python / CET-6\" />\n        </el-form-item>\n        <el-form-item label=\"项目/实践经历\">\n          <el-input v-model=\"form.projectExp\" type=\"textarea\" :rows=\"4\" placeholder=\"请输入项目经历\" />\n        </el-form-item>\n        <el-form-item label=\"自我评价\">\n          <el-input v-model=\"form.selfEval\" type=\"textarea\" :rows=\"3\" placeholder=\"请输入自我评价\" />\n        </el-form-item>\n        <el-form-item label=\"完整简历\">\n          <el-input v-model=\"form.cont\" type=\"textarea\" :rows=\"6\" placeholder=\"可粘贴完整简历正文，或上传附件\" />\n        </el-form-item>\n\n        <el-form-item>\n          <el-button type=\"primary\" :loading=\"saving\" @click=\"handleSave\">保存</el-button>\n          <el-button @click=\"$router.back()\">取消</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, computed, onMounted } from 'vue'\nimport { useRoute, useRouter } from 'vue-router'\nimport { saveResume, resumeDetail } from '@/api/resume'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\n\nconst route = useRoute()\nconst router = useRouter()\n\nconst formRef = ref()\nconst loading = ref(false)\nconst saving = ref(false)\nconst isEdit = computed(() => !!route.query.id)\n\nconst form = reactive({\n  resumeId: null,\n  title: '',\n  isPublic: 1,\n  isDefault: 0,\n  eduJson: '',\n  skill: '',\n  projectExp: '',\n  selfEval: '',\n  cont: '',\n})\n\nconst eduList = ref([])\n\nconst rules = {\n  title: [{ required: true, message: '请输入简历名称', trigger: 'blur' }],\n}\n\nfunction addEdu() {\n  eduList.value.push({ school: '', major: '', degree: '', startDate: '', endDate: '' })\n}\n\nfunction removeEdu(idx) {\n  eduList.value.splice(idx, 1)\n}\n\nasync function loadDetail() {\n  const id = route.query.id\n  if (!id) return\n  loading.value = true\n  try {\n    const data = await resumeDetail(id)\n    Object.assign(form, data)\n    if (data.eduJson) {\n      try {\n        eduList.value = JSON.parse(data.eduJson)\n      } catch {\n        eduList.value = []\n      }\n    }\n  } finally {\n    loading.value = false\n  }\n}\n\nasync function handleSave() {\n  if (!formRef.value) return\n  try {\n    await formRef.value.validate()\n  } catch {\n    return\n  }\n  saving.value = true\n  try {\n    form.eduJson = JSON.stringify(eduList.value)\n    await saveResume({ ...form })\n    success('保存成功')\n    router.push('/student/resumes')\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(loadDetail)\n</script>\n\n<style scoped>\n.edu-item {\n  background: #fafafa;\n  padding: 8px 12px;\n  border-radius: 4px;\n  margin-bottom: 8px;\n}\n</style>\n"],"mappings":";AAwFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AACvD,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAW;AAC/C,SAASC,UAAU,EAAEC,YAAY,QAAQ,cAAa;AACtD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAMC,KAAK,GAAGN,QAAQ,CAAC;IACvB,MAAMO,MAAM,GAAGN,SAAS,CAAC;IAEzB,MAAMO,OAAO,GAAGZ,GAAG,CAAC;IACpB,MAAMa,OAAO,GAAGb,GAAG,CAAC,KAAK;IACzB,MAAMc,MAAM,GAAGd,GAAG,CAAC,KAAK;IACxB,MAAMe,MAAM,GAAGb,QAAQ,CAAC,MAAM,CAAC,CAACQ,KAAK,CAACM,KAAK,CAACC,EAAE;IAE9C,MAAMC,IAAI,GAAGjB,QAAQ,CAAC;MACpBkB,QAAQ,EA