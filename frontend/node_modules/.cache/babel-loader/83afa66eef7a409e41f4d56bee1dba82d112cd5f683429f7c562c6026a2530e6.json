{"ast":null,"code":"import { computed } from 'vue';\nexport default {\n  __name: 'ResumePreview',\n  props: {\n    resume: {\n      type: Object,\n      default: () => ({})\n    },\n    // 投递记录里的 resumeSnapshot 字符串\n    snapshot: {\n      type: String,\n      default: ''\n    }\n  },\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const props = __props;\n    const eduList = computed(() => {\n      if (!props.resume.eduJson) return [];\n      try {\n        const parsed = JSON.parse(props.resume.eduJson);\n        return Array.isArray(parsed) ? parsed : [];\n      } catch {\n        return [];\n      }\n    });\n    const isParsed = computed(() => eduList.value.length > 0);\n    const __returned__ = {\n      props,\n      eduList,\n      isParsed,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","props","__props","eduList","resume","eduJson","parsed","JSON","parse","Array","isArray","isParsed","value","length"],"sources":["F:/sxzp/project0/frontend/new/src/components/ResumePreview.vue"],"sourcesContent":["<template>\n  <div class=\"resume-preview\">\n    <h3 class=\"resume-title\">{{ resume.title || '简历' }}</h3>\n\n    <section v-if=\"eduList.length\" class=\"section\">\n      <h4>教育经历</h4>\n      <div v-for=\"(edu, i) in eduList\" :key=\"i\" class=\"edu-item\">\n        <div class=\"edu-header\">\n          <strong>{{ edu.school || '-' }}</strong>\n          <span class=\"edu-period\">{{ edu.startDate || '?' }} - {{ edu.endDate || '至今' }}</span>\n        </div>\n        <div class=\"edu-detail\">\n          {{ edu.major || '-' }} · {{ edu.degree || '-' }}\n        </div>\n      </div>\n    </section>\n\n    <section v-if=\"resume.skill\" class=\"section\">\n      <h4>技能与证书</h4>\n      <p class=\"content\">{{ resume.skill }}</p>\n    </section>\n\n    <section v-if=\"resume.projectExp\" class=\"section\">\n      <h4>项目/实践经历</h4>\n      <p class=\"content\">{{ resume.projectExp }}</p>\n    </section>\n\n    <section v-if=\"resume.selfEval\" class=\"section\">\n      <h4>自我评价</h4>\n      <p class=\"content\">{{ resume.selfEval }}</p>\n    </section>\n\n    <section v-if=\"resume.cont\" class=\"section\">\n      <h4>完整简历</h4>\n      <pre class=\"content-pre\">{{ resume.cont }}</pre>\n    </section>\n\n    <section v-if=\"snapshot && !isParsed\" class=\"section\">\n      <h4>简历快照</h4>\n      <pre class=\"content-pre\">{{ snapshot }}</pre>\n    </section>\n  </div>\n</template>\n\n<script setup>\nimport { computed } from 'vue'\n\nconst props = defineProps({\n  resume: { type: Object, default: () => ({}) },\n  // 投递记录里的 resumeSnapshot 字符串\n  snapshot: { type: String, default: '' },\n})\n\nconst eduList = computed(() => {\n  if (!props.resume.eduJson) return []\n  try {\n    const parsed = JSON.parse(props.resume.eduJson)\n    return Array.isArray(parsed) ? parsed : []\n  } catch {\n    return []\n  }\n})\n\nconst isParsed = computed(() => eduList.value.length > 0)\n</script>\n\n<style scoped>\n.resume-preview {\n  font-size: 14px;\n  color: #303133;\n}\n.resume-title {\n  margin: 0 0 16px;\n  font-size: 18px;\n}\n.section {\n  margin-bottom: 16px;\n}\n.section h4 {\n  margin: 0 0 8px;\n  font-size: 14px;\n  color: #409eff;\n  border-left: 3px solid #409eff;\n  padding-left: 8px;\n}\n.content {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n.edu-item {\n  margin-bottom: 8px;\n}\n.edu-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.edu-period {\n  font-size: 12px;\n  color: #909399;\n}\n.edu-detail {\n  font-size: 13px;\n  color: #606266;\n  margin-top: 4px;\n}\n</style>\n"],"mappings":"AA6CA,SAASA,QAAQ,QAAQ,KAAI;;;;;;;;;;;;;;;;;;IAE7B,MAAMC,KAAK,GA