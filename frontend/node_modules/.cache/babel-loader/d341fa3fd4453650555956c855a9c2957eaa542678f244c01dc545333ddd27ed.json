{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, computed, onMounted } from 'vue';\nimport { dashboard } from '@/api/stats';\nimport { APPLY_STATE_MAP, INTERVIEW_STATE_MAP } from '@/utils/enums';\nimport PageHeader from '@/components/PageHeader.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport ChartBase from '@/components/ChartBase.vue';\nexport default {\n  __name: 'Dashboard',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loading = ref(false);\n    const data = ref({});\n    const weeklyRate = computed(() => {\n      const total = data.value.weeklyReportCount || 0;\n      const reviewed = data.value.weeklyReviewedCount || 0;\n      if (!total) return 0;\n      return Math.round(reviewed / total * 100);\n    });\n    function buildPieOption(map, countMap) {\n      if (!countMap) return null;\n      const items = Object.entries(countMap).map(([k, v]) => ({\n        name: map[k]?.label || k,\n        value: v\n      }));\n      if (!items.length) return null;\n      return {\n        tooltip: {\n          trigger: 'item',\n          formatter: '{b}: {c} ({d}%)'\n        },\n        legend: {\n          bottom: 0\n        },\n        series: [{\n          type: 'pie',\n          radius: ['40%', '70%'],\n          avoidLabelOverlap: false,\n          itemStyle: {\n            borderRadius: 8,\n            borderColor: '#fff',\n            borderWidth: 2\n          },\n          label: {\n            show: false\n          },\n          emphasis: {\n            label: {\n              show: true,\n              fontSize: 16,\n              fontWeight: 'bold'\n            }\n          },\n          data: items\n        }]\n      };\n    }\n    const applyStateOption = computed(() => buildPieOption(APPLY_STATE_MAP, data.value.applyStateCount));\n    const interviewStateOption = computed(() => buildPieOption(INTERVIEW_STATE_MAP, data.value.interviewStateCount));\n    async function load() {\n      loading.value = true;\n      try {\n        data.value = await dashboard();\n      } catch {\n        // 错误提示已由 request.js 拦截器统一处理\n      } finally {\n        loading.value = false;\n      }\n    }\n    onMounted(load);\n    const __returned__ = {\n      loading,\n      data,\n      weeklyRate,\n      buildPieOption,\n      applyStateOption,\n      interviewStateOption,\n      load,\n      ref,\n      computed,\n      onMounted,\n      get dashboard() {\n        return dashboard;\n      },\n      get APPLY_STATE_MAP() {\n        return APPLY_STATE_MAP;\n      },\n      get INTERVIEW_STATE_MAP() {\n        return INTERVIEW_STATE_MAP;\n      },\n      PageHeader,\n      EmptyState,\n      ChartBase\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","dashboard","APPLY_STATE_MAP","INTERVIEW_STATE_MAP","PageHeader","EmptyState","ChartBase","loading","data","weeklyRate","total","value","weeklyReportCount","reviewed","weeklyReviewedCount","Math","round","buildPieOption","map","countMap","items","Object","entries","k","v","name","label","length","tooltip","trigger","formatter","legend","bottom","series","type","radius","avoidLabelOverlap","itemStyle","borderRadius","borderColor","borderWidth","show","emphasis","fontSize","fontWeight","applyStateOption","applyStateCount","interviewStateOption","interviewStateCount","load"],"sources":["F:/sxzp/project0/frontend/src/views/admin/Dashboard.vue"],"sourcesContent":["<template>\n  <div v-loading=\"loading\" class=\"dashboard\">\n    <PageHeader title=\"仪表盘\" desc=\"平台运营数据总览\" />\n\n    <el-row :gutter=\"16\" class=\"stat-cards\">\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">学生总数</div>\n          <div class=\"stat-value\">{{ data.studentCount || 0 }}</div>\n        </el-card>\n      </el-col>\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">企业总数</div>\n          <div class=\"stat-value\">{{ data.companyCount || 0 }}</div>\n          <div class=\"stat-sub\">已认证 {{ data.companyAuthedCount || 0 }}</div>\n        </el-card>\n      </el-col>\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">岗位总数</div>\n          <div class=\"stat-value\">{{ data.jobCount || 0 }}</div>\n          <div class=\"stat-sub\">在线 {{ data.jobOnlineCount || 0 }}</div>\n        </el-card>\n      </el-col>\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">投递总数</div>\n          <div class=\"stat-value\">{{ data.applyCount || 0 }}</div>\n          <div class=\"stat-sub\">今日 {{ data.todayApplyCount || 0 }}</div>\n        </el-card>\n      </el-col>\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">面试总数</div>\n          <div class=\"stat-value\">{{ data.interviewCount || 0 }}</div>\n        </el-card>\n      </el-col>\n      <el-col :xs=\"12\" :sm=\"8\" :md=\"6\" :lg=\"4\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">协议总数</div>\n          <div class=\"stat-value\">{{ data.agreementCount || 0 }}</div>\n          <div class=\"stat-sub\">已签 {{ data.agreementSignedCount || 0 }}</div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"16\" class=\"chart-row\">\n      <el-col :xs=\"24\" :md=\"12\">\n        <el-card shadow=\"never\">\n          <template #header>投递状态分布</template>\n          <ChartBase v-if=\"applyStateOption\" :option=\"applyStateOption\" />\n          <EmptyState v-else text=\"暂无数据\" />\n        </el-card>\n      </el-col>\n      <el-col :xs=\"24\" :md=\"12\">\n        <el-card shadow=\"never\">\n          <template #header>面试状态分布</template>\n          <ChartBase v-if=\"interviewStateOption\" :option=\"interviewStateOption\" />\n          <EmptyState v-else text=\"暂无数据\" />\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"16\" class=\"chart-row\">\n      <el-col :xs=\"24\" :md=\"12\">\n        <el-card shadow=\"never\">\n          <template #header>周报统计</template>\n          <div class=\"weekly-stats\">\n            <div>周报总数：{{ data.weeklyReportCount || 0 }}</div>\n            <div>已评价：{{ data.weeklyReviewedCount || 0 }}</div>\n            <div>评价率：{{ weeklyRate }}%</div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted } from 'vue'\nimport { dashboard } from '@/api/stats'\nimport { APPLY_STATE_MAP, INTERVIEW_STATE_MAP } from '@/utils/enums'\nimport PageHeader from '@/components/PageHeader.vue'\nimport EmptyState from '@/components/EmptyState.vue'\nimport ChartBase from '@/components/ChartBase.vue'\n\nconst loading = ref(false)\nconst data = ref({})\n\nconst weeklyRate = computed(() => {\n  const total = data.value.weeklyReportCount || 0\n  const reviewed = data.value.weeklyReviewedCount || 0\n  if (!total) return 0\n  return Math.round((reviewed / total) * 100)\n})\n\nfunction buildPieOption(map, countMap) {\n  if (!countMap) return null\n  const items = Object.entries(countMap).map(([k, v]) => ({\n    name: map[k]?.label || k,\n    value: v,\n  }))\n  if (!items.length) return null\n  return {\n    tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },\n    legend: { bottom: 0 },\n    series: [\n      {\n        type: 'pie',\n        radius: ['40%', '70%'],\n        avoidLabelOverlap: false,\n        itemStyle: { borderRadius: 8, borderColor: '#fff', borderWidth: 2 },\n        label: { show: false },\n        emphasis: { label: { show: true, fontSize: 16, fontWeight: 'bold' } },\n        data: items,\n      },\n    ],\n  }\n}\n\nconst applyStateOption = computed(() =>\n  buildPieOption(APPLY_STATE_MAP, data.value.applyStateCount)\n)\nconst interviewStateOption = computed(() =>\n  buildPieOption(INTERVIEW_STATE_MAP, data.value.interviewStateCount)\n)\n\nasync function load() {\n  loading.value = true\n  try {\n    data.value = await dashboard()\n  } catch {\n    // 错误提示已由 request.js 拦截器统一处理\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(load)\n</script>\n\n<style scoped>\n.stat-cards {\n  margin-bottom: 16px;\n}\n.stat-card {\n  margin-bottom: 16px;\n  text-align: center;\n}\n.stat-title {\n  font-size: 13px;\n  color: #909399;\n}\n.stat-value {\n  font-size: 28px;\n  font-weight: 600;\n  color: #303133;\n  margin: 8px 0;\n}\n.stat-sub {\n  font-size: 12px;\n  color: #909399;\n}\n.chart-row {\n  margin-bottom: 16px;\n}\n.weekly-stats {\n  font-size: 14px;\n  color: #606266;\n  line-height: 2;\n  padding: 16px 0;\n}\n</style>\n"],"mappings":";;AAgFA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AAC7C,SAASC,SAAS,QAAQ,aAAY;AACtC,SAASC,eAAe,EAAEC,mBAAmB,QAAQ,eAAc;AACnE,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,SAAS,MAAM,4BAA2B;;;;;;;IAEjD,MAAMC,OAAO,GAAGT,GAAG,CAAC,KAAK;IACzB,MAAMU,IAAI,GAAGV,GAAG,CAAC,CAAC,CAAC;IAEnB,MAAMW,UAAU,GAAGV,QAAQ,CAAC,MAAM;MAChC,MAAMW,KAAK,GAAGF,IAAI,CAACG,KAAK,CAACC,iBAAiB,IAAI;MAC9C,MAAMC,QAAQ,GAAGL,IAAI,CAACG,KAAK,CAACG,mBAAmB,IAAI;MACnD,IAAI,CAACJ,KAAK,EAAE,OAAO;MACnB,OAAOK,IAAI,CAACC,KAAK,CAAEH,QAAQ,GAAGH,KAAK,GAAI,GAAG;IAC5C,CAAC;IAED,SAASO,cAAcA,CAACC,GAAG,EAAEC,QAAQ,EAAE;MACrC,IAAI,CAACA,QAAQ,EAAE,OAAO,IAAG;MACzB,MAAMC,KAAK,GAAGC,MAAM,CAACC,OAAO,CAACH,QAAQ,CAAC,CAACD,GAAG,CAAC,CAAC,CAACK,CAAC,EAAEC,CAAC,CAAC,MAAM;QACtDC,IAAI,EAAEP,GAAG,CAACK,CAAC,CAAC,EAAEG,KAAK,IAAIH,CAAC;QACxBZ,KAAK,EAAEa;MACT,CAAC,CAAC;MACF,IAAI,CAACJ,KAAK,CAACO,MAAM,EAAE,OAAO,IAAG