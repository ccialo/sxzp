{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useRouter } from 'vue-router';\nimport { useAuthStore } from '@/stores/auth';\nimport { getHomeRoute } from '@/permission';\nexport default {\n  __name: 'Home',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const router = useRouter();\n    const authStore = useAuthStore();\n    const features = [{\n      title: '岗位检索',\n      desc: '关键词、类型、地点多维度筛选，找到心仪实习',\n      icon: 'Search'\n    }, {\n      title: '简历管理',\n      desc: '在线编辑多份简历，灵活切换投递',\n      icon: 'Document'\n    }, {\n      title: '面试安排',\n      desc: '企业发起面试通知，学生一键确认',\n      icon: 'Calendar'\n    }, {\n      title: '协议签署',\n      desc: '实习协议线上发起与签署，留痕可追溯',\n      icon: 'Files'\n    }, {\n      title: '实习周报',\n      desc: '学生提交周报，企业在线评价',\n      icon: 'EditPen'\n    }, {\n      title: '消息通知',\n      desc: '投递、面试、协议变更全程站内信提醒',\n      icon: 'Bell'\n    }];\n    function goHome() {\n      router.push(getHomeRoute(authStore.userType));\n    }\n    const __returned__ = {\n      router,\n      authStore,\n      features,\n      goHome,\n      get useRouter() {\n        return useRouter;\n      },\n      get useAuthStore() {\n        return useAuthStore;\n      },\n      get getHomeRoute() {\n        return getHomeRoute;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["useRouter","useAuthStore","getHomeRoute","router","authStore","features","title","desc","icon","goHome","push","userType"],"sources":["F:/sxzp/project0/frontend/src/views/Home.vue"],"sourcesContent":["<template>\n  <div class=\"home-page\">\n    <section class=\"hero\">\n      <div class=\"hero-content\">\n        <h1 class=\"hero-title\">校园实习招聘管理平台</h1>\n        <p class=\"hero-subtitle\">连接学生与企业，开启职业第一步</p>\n        <div class=\"hero-actions\">\n          <el-button type=\"primary\" size=\"large\" @click=\"$router.push('/jobs')\">\n            立即检索岗位\n          </el-button>\n          <el-button size=\"large\" class=\"screen-entry\" @click=\"$router.push('/screen')\">\n            <el-icon><DataAnalysis /></el-icon>\n            数据大屏\n          </el-button>\n          <el-button v-if=\"!authStore.isLoggedIn\" size=\"large\" @click=\"$router.push('/register')\">\n            注册账号\n          </el-button>\n          <el-button v-else size=\"large\" @click=\"goHome\">进入主页</el-button>\n        </div>\n      </div>\n    </section>\n    <section class=\"features\">\n      <div class=\"features-inner\">\n        <div v-for=\"f in features\" :key=\"f.title\" class=\"feature-card\">\n          <el-icon :size=\"40\" class=\"feature-icon\"><component :is=\"f.icon\" /></el-icon>\n          <h3>{{ f.title }}</h3>\n          <p>{{ f.desc }}</p>\n        </div>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script setup>\nimport { useRouter } from 'vue-router'\nimport { useAuthStore } from '@/stores/auth'\nimport { getHomeRoute } from '@/permission'\n\nconst router = useRouter()\nconst authStore = useAuthStore()\n\nconst features = [\n  { title: '岗位检索', desc: '关键词、类型、地点多维度筛选，找到心仪实习', icon: 'Search' },\n  { title: '简历管理', desc: '在线编辑多份简历，灵活切换投递', icon: 'Document' },\n  { title: '面试安排', desc: '企业发起面试通知，学生一键确认', icon: 'Calendar' },\n  { title: '协议签署', desc: '实习协议线上发起与签署，留痕可追溯', icon: 'Files' },\n  { title: '实习周报', desc: '学生提交周报，企业在线评价', icon: 'EditPen' },\n  { title: '消息通知', desc: '投递、面试、协议变更全程站内信提醒', icon: 'Bell' },\n]\n\nfunction goHome() {\n  router.push(getHomeRoute(authStore.userType))\n}\n</script>\n\n<style scoped>\n.home-page {\n  min-height: 100vh;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n}\n.hero {\n  height: 480px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  color: #fff;\n}\n.hero-title {\n  font-size: 44px;\n  font-weight: 700;\n  margin: 0 0 16px;\n}\n.hero-subtitle {\n  font-size: 18px;\n  margin: 0 0 32px;\n  opacity: 0.9;\n}\n.hero-actions {\n  display: flex;\n  gap: 16px;\n  justify-content: center;\n}\n.features {\n  background: #f5f7fa;\n  padding: 48px 24px;\n}\n.features-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n}\n.feature-card {\n  background: #fff;\n  padding: 32px 24px;\n  border-radius: 8px;\n  text-align: center;\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);\n  transition: transform 0.3s;\n}\n.feature-card:hover {\n  transform: translateY(-4px);\n}\n.feature-icon {\n  color: #409eff;\n  margin-bottom: 12px;\n}\n.feature-card h3 {\n  margin: 0 0 8px;\n  font-size: 18px;\n  color: #303133;\n}\n.feature-card p {\n  margin: 0;\n  font-size: 14px;\n  color: #606266;\n  line-height: 1.6;\n}\n@media (max-width: 768px) {\n  .features-inner {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n"],"mappings":";AAkCA,SAASA,SAAS,QAAQ,YAAW;AACrC,SAASC,YAAY,QAAQ,eAAc;AAC3C,SAASC,YAAY,QAAQ,cAAa;;;;;;;IAE1C,MAAMC,MAAM,GAAGH,SAAS,CAAC;IACzB,MAAMI,SAAS,GAAGH,YAAY,CAAC;IAE/B,MAAMI,QAAQ,GAAG,CACf;MAAEC,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,uBAAuB;MAAEC,IAAI,EAAE;IAAS,CAAC,EAChE;MAAEF,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,iBAAiB;MAAEC,IAAI,EAAE;IAAW,CAAC,EAC5D;MAAEF,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,iBAAiB;MAAEC,IAAI,EAAE;IAAW,CAAC,EAC5D;MAAEF,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,mBAAmB;MAAEC,IAAI,EAAE;IAAQ,CAAC,EAC3D;MAAEF,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,eAAe;MAAEC,IAAI,EAAE;IAAU,CAAC,EACzD;MAAEF,KAAK,EAAE,MAAM;MAAEC,IAAI,EAAE,mBAAmB;MAAEC,IAAI,EAAE;IAAO,CAAC,CAC5D;IAEA,SAASC,MAAMA,CAAA,EAAG;MAChBN,MAAM,CAACO,IAAI,CAACR,YAAY,CAACE,SAAS,CAACO,QAAQ,CAAC;IAC9C","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}