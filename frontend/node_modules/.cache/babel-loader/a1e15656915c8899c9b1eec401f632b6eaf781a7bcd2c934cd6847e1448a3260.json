{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { listResumes, setDefault, deleteResume } from '@/api/resume';\nimport { formatDateTime } from '@/utils/format';\nimport { success } from '@/utils/message';\nimport { ElMessageBox } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'ResumeList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const list = ref([]);\n    const loading = ref(false);\n    async function load() {\n      loading.value = true;\n      try {\n        list.value = await listResumes();\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function handleSetDefault(row) {\n      await setDefault(row.resumeId);\n      success('已设为默认');\n      load();\n    }\n    async function handleDelete(row) {\n      try {\n        await ElMessageBox.confirm(`确定删除简历「${row.title}」吗？`, '提示', {\n          confirmButtonText: '删除',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await deleteResume(row.resumeId);\n      success('删除成功');\n      load();\n    }\n    onMounted(load);\n    const __returned__ = {\n      list,\n      loading,\n      load,\n      handleSetDefault,\n      handleDelete,\n      ref,\n      onMounted,\n      get listResumes() {\n        return listResumes;\n      },\n      get setDefault() {\n        return setDefault;\n      },\n      get deleteResume() {\n        return deleteResume;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      PageHeader,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","listResumes","setDefault","deleteResume","formatDateTime","success","ElMessageBox","PageHeader","EmptyState","list","loading","load","value","handleSetDefault","row","resumeId","handleDelete","confirm","title","confirmButtonText","cancelButtonText","type"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/ResumeList.vue"],"sourcesContent":["<template>\n  <div class=\"resume-list\">\n    <PageHeader title=\"我的简历\" desc=\"管理多份简历，灵活切换投递\">\n      <template #actions>\n        <el-button type=\"primary\" @click=\"$router.push('/student/resumes/edit')\">\n          <el-icon><Plus /></el-icon>新建简历\n        </el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border style=\"width: 100%\">\n        <el-table-column prop=\"title\" label=\"简历名称\" min-width=\"200\" />\n        <el-table-column label=\"是否公开\" width=\"120\">\n          <template #default=\"{ row }\">\n            <el-tag :type=\"row.isPublic ? 'success' : 'info'\" size=\"small\">\n              {{ row.isPublic ? '公开' : '私密' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"默认简历\" width=\"120\">\n          <template #default=\"{ row }\">\n            <el-tag v-if=\"row.isDefault\" type=\"success\" size=\"small\">默认</el-tag>\n            <span v-else>-</span>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"更新时间\" width=\"180\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.updateTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"240\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"$router.push(`/student/resumes/edit?id=${row.resumeId}`)\">\n              编辑\n            </el-button>\n            <el-button\n              v-if=\"!row.isDefault\"\n              size=\"small\"\n              type=\"success\"\n              @click=\"handleSetDefault(row)\"\n            >\n              设为默认\n            </el-button>\n            <el-button size=\"small\" type=\"danger\" @click=\"handleDelete(row)\">删除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"还没有简历，点击右上角新建一份吧\" />\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { listResumes, setDefault, deleteResume } from '@/api/resume'\nimport { formatDateTime } from '@/utils/format'\nimport { success } from '@/utils/message'\nimport { ElMessageBox } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst list = ref([])\nconst loading = ref(false)\n\nasync function load() {\n  loading.value = true\n  try {\n    list.value = await listResumes()\n  } finally {\n    loading.value = false\n  }\n}\n\nasync function handleSetDefault(row) {\n  await setDefault(row.resumeId)\n  success('已设为默认')\n  load()\n}\n\nasync function handleDelete(row) {\n  try {\n    await ElMessageBox.confirm(`确定删除简历「${row.title}」吗？`, '提示', {\n      confirmButtonText: '删除',\n      cancelButtonText: '取消',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await deleteResume(row.resumeId)\n  success('删除成功')\n  load()\n}\n\nonMounted(load)\n</script>\n"],"mappings":"AAoDA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,WAAW,EAAEC,UAAU,EAAEC,YAAY,QAAQ,cAAa;AACnE,SAASC,cAAc,QAAQ,gBAAe;AAC9C,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,QAAQ,cAAa;AAC1C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAMC,IAAI,GAAGV,GAAG,CAAC,EAAE;IACnB,MAAMW,OAAO,GAAGX,GAAG,CAAC,KAAK;IAEzB,eAAeY,IAAIA,CAAA,EAAG;MACpBD,OAAO,CAACE,KAAK,GAAG,IAAG;MACnB,IAAI;QACFH,IAAI,CAACG,KAAK,GAAG,MAAMX,WAAW,CAAC;MACjC,CAAC,SAAS;QACRS,OAAO,CAACE,KAAK,GAAG,KAAI;MACtB;IACF;IAEA,eAAeC,gBAAgBA,CAACC,GAAG,EAAE;MACnC,MAAMZ,UAA