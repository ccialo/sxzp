{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { adminJobPage, auditJob } from '@/api/job';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatMoney } from '@/utils/format';\nimport { JOB_AUDIT_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport DictTag from '@/components/DictTag.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport AuditDialog from '@/components/AuditDialog.vue';\nexport default {\n  __name: 'JobAudit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(adminJobPage, {\n      auditState: 'pending',\n      keyword: '',\n      current: 1,\n      size: 10\n    });\n    const auditVisible = ref(false);\n    const detailVisible = ref(false);\n    const current = ref(null);\n    function openAudit(row) {\n      current.value = row;\n      auditVisible.value = true;\n    }\n    function showDetail(row) {\n      current.value = row;\n      detailVisible.value = true;\n    }\n    async function handleAudit(form) {\n      if (!current.value) return;\n      await auditJob({\n        jobId: current.value.jobId,\n        pass: form.pass,\n        opinion: form.opinion\n      });\n      success(form.pass ? '审核通过' : '已驳回');\n      auditVisible.value = false;\n      fetchList();\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      auditVisible,\n      detailVisible,\n      current,\n      openAudit,\n      showDetail,\n      handleAudit,\n      ref,\n      onMounted,\n      get adminJobPage() {\n        return 