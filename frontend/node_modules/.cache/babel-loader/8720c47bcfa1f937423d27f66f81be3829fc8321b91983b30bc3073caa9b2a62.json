true\n}\n\nfunction showDetail(row) {\n  current.value = row\n  detailVisible.value = true\n}\n\nasync function handleAudit(form) {\n  if (!current.value) return\n  await auditJob({\n    jobId: current.value.jobId,\n    pass: form.pass,\n    opinion: form.opinion,\n  })\n  success(form.pass ? '审核通过' : '已驳回')\n  auditVisible.value = false\n  fetchList()\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n.content-pre {\n  margin: 0 0 16px;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n</style>\n"],"mappings":"AAmGA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,YAAY,EAAEC,QAAQ,QAAQ,WAAU;AACjD,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,WAAW,QAAQ,gBAAe;AAC3C,SAASC,mBAAmB,QAAQ,eAAc;AAClD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,OAAO,MAAM,0BAAyB;AAC7C,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,WAAW,MAAM,8BAA6B;;;;;;;IAErD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGhB,aAAa,CAACF,YAAY,EAAE;MAAEmB,UAAU,EAAE,SAAS;MAAEC,OAAO,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAE1F,MAAMC,YAAY,GAAGzB,GAAG,CAAC,KAAK;IAC9B,MAAM0B,aAAa,GAAG1B,GAAG,CAAC,KAAK;IAC/B,MAAMuB,OAAO,GAAGvB,GAAG,CAAC,IAAI;IAExB,SAAS2B,SAASA,CAACC,GAAG,EAAE;MACtBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBH,YAAY,CAACI,KAAK,GAAG,IAAG;IAC1B;IAEA,SAASC,UAAUA,CAACF,GAAG,EAAE;MACvBL,OAAO,CAACM,KAAK,GAAGD,GAAE;MAClBF,aAAa,CAACG,KAAK,GAAG,IAAG;IAC3B;IAEA,eAAeE,WAAWA,CAACC,IAAI,EAAE;MAC/B,IAAI,CAACT,OAAO,CAACM,KAAK,EAAE;MACpB,MAAM1B,QAAQ,CAAC;QACb8B,KAAK,EAAEV,OAAO,CAACM,KAAK,CAACI,KAAK;QAC1BC,IAAI,EAAEF,IAAI,CAACE,IAAI;QACfC,OAAO,EAAEH,IAAI,CAACG;MAChB,CAAC;MACD5B,OAAO,CAACyB,IAAI,CAACE,IAAI,GAAG,MAAM,GAAG,KAAK;MAClCT,YAAY,CAACI,KAAK,GAAG,KAAI;MACzBZ,SAAS,CAAC;IACZ;IAEAhB,SAAS,CAACgB,SAAS","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}