{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { detail } from '@/api/company';\nimport { formatPhone } from '@/utils/format';\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport DictTag from '@/components/DictTag.vue';\nimport FilePreview from '@/components/FilePreview.vue';\nexport default {\n  __name: 'CompanyDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const company = ref(null);\n    const loading = ref(false);\n    async function load() {\n      const id = route.params.id;\n      loading.value = true;\n      try {\n        company.value = await detail(id);\n      } finally {\n        loading.value = false;\n      }\n    }\n    onMounted(load);\n    const __returned__ = {\n      route,\n      company,\n      loading,\n      load,\n      ref,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get detail() {\n        return detail;\n      },\n      get formatPhone() {\n        return formatPhone;\n      },\n      get COMPANY_AUTH_STATE_MAP() {\n        return COMPANY_AUTH_STATE_MAP;\n      },\n      PageHeader,\n      StateBadge,\n      DictTag,\n      FilePreview\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","detail","formatPhone","COMPANY_AUTH_STATE_MAP","PageHeader","StateBadge","DictTag","FilePreview","route","company","loading","load","id","params","value"],"sources":["F:/sxzp/project0/frontend/src/views/public/CompanyDetail.vue"],"sourcesContent":["<template>\n  <div v-loading=\"loading\" class=\"company-detail\">\n    <PageHeader>\n      <template #title>\n        <span>{{ company?.entName }}</span>\n      </template>\n      <template #actions>\n        <el-button @click=\"$router.back()\">返回</el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-if=\"company\" class=\"info-card\">\n      <div class=\"header\">\n        <div class=\"title-row\">\n          <el-icon :size=\"32\" color=\"#409eff\"><OfficeBuilding /></el-icon>\n          <h2>{{ company.entName }}</h2>\n          <StateBadge\n            v-if=\"company.authState\"\n            :state=\"company.authState\"\n            :map=\"COMPANY_AUTH_STATE_MAP\"\n          />\n        </div>\n      </div>\n\n      <div class=\"info-grid\">\n        <div v-if=\"company.category\" class=\"info-item\">\n          <el-icon><Collection /></el-icon>\n          <DictTag type-code=\"company_category\" :code=\"company.category\" />\n        </div>\n        <div v-if=\"company.address\" class=\"info-item\">\n          <el-icon><Location /></el-icon>\n          <span>{{ company.address }}</span>\n        </div>\n        <div v-if=\"company.contactName\" class=\"info-item\">\n          <el-icon><User /></el-icon>\n          <span>联系人：{{ company.contactName }}</span>\n        </div>\n        <div v-if=\"company.contactPhone\" class=\"info-item\">\n          <el-icon><Phone /></el-icon>\n          <span>{{ formatPhone(company.contactPhone) }}</span>\n        </div>\n        <div v-if=\"company.contactEmail\" class=\"info-item\">\n          <el-icon><Message /></el-icon>\n          <span>{{ company.contactEmail }}</span>\n        </div>\n      </div>\n\n      <el-divider />\n\n      <h3>企业简介</h3>\n      <pre class=\"content-pre\">{{ company.intro || '暂无简介' }}</pre>\n\n      <div v-if=\"company.certFile\" class=\"cert\">\n        <h3>资质证明</h3>\n        <FilePreview :path=\"company.certFile\" file-name=\"资质文件\" />\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { useRoute } from 'vue-router'\nimport { detail } from '@/api/company'\nimport { formatPhone } from '@/utils/format'\nimport { COMPANY_AUTH_STATE_MAP } from '@/utils/enums'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport DictTag from '@/components/DictTag.vue'\nimport FilePreview from '@/components/FilePreview.vue'\n\nconst route = useRoute()\nconst company = ref(null)\nconst loading = ref(false)\n\nasync function load() {\n  const id = route.params.id\n  loading.value = true\n  try {\n    company.value = await detail(id)\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(load)\n</script>\n\n<style scoped>\n.info-card {\n  padding: 4px;\n}\n.title-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.title-row h2 {\n  margin: 0;\n  font-size: 22px;\n  color: #303133;\n}\n.info-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 12px;\n  margin-top: 16px;\n}\n.info-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #606266;\n}\nh3 {\n  margin: 16px 0 8px;\n  font-size: 16px;\n  color: #303133;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n.cert {\n  margin-top: 24px;\n}\n</style>\n"],"mappings":"AA6DA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,QAAQ,QAAQ,YAAW;AACpC,SAASC,MAAM,QAAQ,eAAc;AACrC,SAASC,WAAW,QAAQ,gBAAe;AAC3C,SAASC,sBAAsB,QAAQ,eAAc;AACrD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,OAAO,MAAM,0BAAyB;AAC7C,OAAOC,WAAW,MAAM,8BAA6B;;;;;;;IAErD,MAAMC,KAAK,GAAGR,QAAQ,CAAC;IACvB,MAAMS,OAAO,GAAGX,GAAG,CAAC,IAAI;IACxB,MAAMY,OAAO,GAAGZ,GAAG,CAAC,KAAK;IAEzB,eAAea,IAAIA,CAAA,EAAG;MACpB,MAAMC,EAAE,GAAGJ,KAAK,CAACK,MAAM,CAACD,EAAC;MACzBF,OAAO,CAACI,KAAK,GAAG,IAAG;MACnB,IAAI;QACFL,OAAO,CAACK,KAAK,GAAG,MAAMb,MAAM,CAACW,EAAE;MACjC,CAAC,SAAS;QACRF,OAAO,CAACI,KAAK,GAAG,KAAI;MACtB;IACF;IAEAf,SAAS,CAACY,IAAI","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}