{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { sentAgreements } from '@/api/agreement';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDate, formatDateTime, formatMoney } from '@/utils/format';\nimport { AGREEMENT_STATE_MAP } from '@/utils/enums';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'AgreementSent',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(sentAgreements, {\n      state: '',\n      current: 1,\n      size: 10\n    });\n    const contentVisible = ref(false);\n    const current = ref(null);\n    function showContent(row) {\n      current.value = row;\n      contentVisible.value = true;\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      contentVisible,\n      current,\n      showContent,\n      ref,\n      onMounted,\n      get sentAgreements() {\n        return sentAgreements;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDate() {\n        return formatDate;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get formatMoney() {\n        return formatMoney;\n      },\n      get AGREEMENT_STATE_MAP() {\n        return AGREEMENT_STATE_MAP;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","sentAgreements","usePagination","formatDate","formatDateTime","formatMoney","AGREEMENT_STATE_MAP","PageHeader","StateBadge","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","state","current","size","contentVisible","showContent","row","value"],"sources":["F:/sxzp/project0/frontend/src/views/company/AgreementSent.vue"],"sourcesContent":["<template>\n  <div class=\"agreement-sent\">\n    <PageHeader title=\"已发出协议\" desc=\"跟踪实习协议签署状态\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.state\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待签署</el-radio-button>\n        <el-radio-button label=\"signed\">已签署</el-radio-button>\n        <el-radio-button label=\"rejected\">已拒绝</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"studentName\" label=\"学生\" min-width=\"100\" />\n        <el-table-column prop=\"jobTitle\" label=\"岗位\" min-width=\"160\" />\n        <el-table-column label=\"实习期\" min-width=\"200\">\n          <template #default=\"{ row }\">\n            {{ formatDate(row.startDate) }} ~ {{ formatDate(row.endDate) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"津贴\" width=\"120\">\n          <template #default=\"{ row }\">{{ formatMoney(row.salary) }}</template>\n        </el-table-column>\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.state\" :map=\"AGREEMENT_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"签署时间\" width=\"180\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.signTime) }}</template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button size=\"small\" @click=\"showContent(row)\">查看内容</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无协议记录\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n\n    <el-dialog v-model=\"contentVisible\" title=\"协议内容\" width=\"640px\">\n      <pre class=\"content-pre\">{{ current?.content || '暂无内容' }}</pre>\n      <template #footer>\n        <el-button @click=\"contentVisible = false\">关闭</el-button>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { sentAgreements } from '@/api/agreement'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDate, formatDateTime, formatMoney } from '@/utils/format'\nimport { AGREEMENT_STATE_MAP } from '@/utils/enums'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(sentAgreements, { state: '', current: 1, size: 10 })\n\nconst contentVisible = ref(false)\nconst current = ref(null)\n\nfunction showContent(row) {\n  current.value = row\n  contentVisible.value = true\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  