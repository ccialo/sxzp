{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, computed, onMounted } from 'vue';\nimport { jobRanking } from '@/api/stats';\nimport { JOB_AUDIT_STATE_MAP } from '@/utils/enums';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nimport ChartBase from '@/components/ChartBase.vue';\nexport default {\n  __name: 'JobRanking',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const loading = ref(false);\n    const list = ref([]);\n    const limit = ref(10);\n    const chartOption = computed(() => {\n      if (!list.value.length) return null;\n      const sorted = [...list.value].sort((a, b) => (b.applyCount || 0) - (a.applyCount || 0));\n      return {\n        tooltip: {\n          trigger: 'axis',\n          axisPointer: {\n            type: 'shadow'\n          }\n        },\n        grid: {\n          left: '3%',\n          right: '4%',\n          bottom: '3%',\n          containLabel: true\n        },\n        xAxis: {\n          type: 'category',\n          data: sorted.map(j => j.jobTitle),\n          axisLabel: {\n            rotate: 30,\n            interval: 0\n          }\n        },\n        yAxis: {\n          type: 'value',\n          name: '投递数'\n        },\n        series: [{\n          type: 'bar',\n          data: sorted.map(j => j.applyCount || 0),\n          itemStyle: {\n            color: '#409eff',\n            borderRadius: [4, 4, 0, 0]\n          },\n          label: {\n            show: true,\n            position: 'top'\n          }\n        }]\n      };\n    });\n    async function load() {\n      loading.value = true;\n      try {\n        list.value = await jobRanking({\n          limit: limit.value\n        });\n      } finally {\n        loading.value = false;\n      }\n    }\n    onMounted(load);\n    const __returned__ = {\n      loading,\n      list,\n      limit,\n      chartOption,\n      load,\n      ref,\n      computed,\n      onMounted,\n      get jobRanking() {\n        return jobRanking;\n      },\n      get JOB_AUDIT_STATE_MAP() {\n        return JOB_AUDIT_STATE_MAP;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState,\n      ChartBase\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","jobRanking","JOB_AUDIT_STATE_MAP","PageHeader","StateBadge","EmptyState","ChartBase","loading","list","limit","chartOption","value","length","sorted","sort","a","b","applyCount","tooltip","trigger","axisPointer","type","grid","left","right","bottom","containLabel","xAxis","data","map","j","jobTitle","axisLabel","rotate","interval","yAxis","name","series","itemStyle","color","borderRadius","label","show","position","load"],"sources":["F:/sxzp/project0/frontend/new/src/views/admin/JobRanking.vue"],"sourcesContent":["<template>\n  <div v-loading=\"loading\" class=\"job-ranking\">\n    <PageHeader title=\"热门岗位\" desc=\"按投递数排序的岗位排行\" />\n\n    <div class=\"filter-bar\">\n      <span>展示前</span>\n      <el-input-number v-model=\"limit\" :min=\"5\" :max=\"50\" :step=\"5\" />\n      <span>条</span>\n      <el-button type=\"primary\" @click=\"load\">刷新</el-button>\n    </div>\n\n    <el-row :gutter=\"16\">\n      <el-col :xs=\"24\" :md=\"12\">\n        <el-card shadow=\"never\">\n          <template #header>投递排行柱状图</template>\n          <ChartBase v-if=\"chartOption\" :option=\"chartOption\" height=\"400px\" />\n          <EmptyState v-else text=\"暂无数据\" />\n        </el-card>\n      </el-col>\n      <el-col :xs=\"24\" :md=\"12\">\n        <el-card shadow=\"never\">\n          <template #header>排行明细</template>\n          <el-table :data=\"list\" border>\n            <el-table-column type=\"index\" label=\"排名\" width=\