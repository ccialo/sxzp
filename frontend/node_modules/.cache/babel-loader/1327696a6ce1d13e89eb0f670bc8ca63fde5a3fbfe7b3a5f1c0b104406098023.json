{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { myInterviews, confirmInterview, cancelInterview } from '@/api/interview';\nimport { usePagination } from '@/composables/usePagination';\nimport { formatDateTime } from '@/utils/format';\nimport { INTERVIEW_STATE_MAP } from '@/utils/enums';\nimport { success } from '@/utils/message';\nimport { ElMessageBox, ElMessage } from 'element-plus';\nimport PageHeader from '@/components/PageHeader.vue';\nimport StateBadge from '@/components/StateBadge.vue';\nimport EmptyState from '@/components/EmptyState.vue';\nexport default {\n  __name: 'InterviewList',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch\n    } = usePagination(myInterviews, {\n      state: '',\n      current: 1,\n      size: 10\n    });\n    async function handleConfirm(row) {\n      await confirmInterview(row.interviewId);\n      success('已确认面试');\n      fetchList();\n    }\n    async function handleCancel(row) {\n      try {\n        await ElMessageBox.confirm('确定取消这场面试吗？', '提示', {\n          confirmButtonText: '取消面试',\n          cancelButtonText: '保留',\n          type: 'warning'\n        });\n      } catch {\n        return;\n      }\n      await cancelInterview(row.interviewId);\n      success('已取消面试');\n      fetchList();\n    }\n    function showRemark(row) {\n      ElMessage.info(row.remark);\n    }\n    onMounted(fetchList);\n    const __returned__ = {\n      query,\n      list,\n      total,\n      loading,\n      fetchList,\n      handlePageChange,\n      handleSizeChange,\n      handleSearch,\n      handleConfirm,\n      handleCancel,\n      showRemark,\n      ref,\n      onMounted,\n      get myInterviews() {\n        return myInterviews;\n      },\n      get confirmInterview() {\n        return confirmInterview;\n      },\n      get cancelInterview() {\n        return cancelInterview;\n      },\n      get usePagination() {\n        return usePagination;\n      },\n      get formatDateTime() {\n        return formatDateTime;\n      },\n      get INTERVIEW_STATE_MAP() {\n        return INTERVIEW_STATE_MAP;\n      },\n      get success() {\n        return success;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      PageHeader,\n      StateBadge,\n      EmptyState\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","myInterviews","confirmInterview","cancelInterview","usePagination","formatDateTime","INTERVIEW_STATE_MAP","success","ElMessageBox","ElMessage","PageHeader","StateBadge","EmptyState","query","list","total","loading","fetchList","handlePageChange","handleSizeChange","handleSearch","state","current","size","handleConfirm","row","interviewId","handleCancel","confirm","confirmButtonText","cancelButtonText","type","showRemark","info","remark"],"sources":["F:/sxzp/project0/frontend/new/src/views/student/InterviewList.vue"],"sourcesContent":["<template>\n  <div class=\"interview-list\">\n    <PageHeader title=\"我的面试\" desc=\"确认或取消已安排的面试\" />\n\n    <div class=\"filter-bar\">\n      <el-radio-group v-model=\"query.state\" @change=\"handleSearch\">\n        <el-radio-button label=\"\">全部</el-radio-button>\n        <el-radio-button label=\"pending\">待确认</el-radio-button>\n        <el-radio-button label=\"confirmed\">已确认</el-radio-button>\n        <el-radio-button label=\"done\">已完成</el-radio-button>\n        <el-radio-button label=\"cancelled\">已取消</el-radio-button>\n      </el-radio-group>\n    </div>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-table :data=\"list\" border>\n        <el-table-column prop=\"jobTitle\" label=\"岗位\" min-width=\"160\" />\n        <el-table-column prop=\"companyName\" label=\"企业\" min-width=\"140\" />\n        <el-table-column label=\"面试时间\" width=\"180\">\n          <template #default=\"{ row }\">{{ formatDateTime(row.interviewTime) }}</template>\n        </el-table-column>\n        <el-table-column prop=\"place\" label=\"地点\" min-width=\"140\" />\n        <el-table-column prop=\"contact\" label=\"联系人\" width=\"100\" />\n        <el-table-column prop=\"contactPhone\" label=\"联系电话\" width=\"140\" />\n        <el-table-column label=\"状态\" width=\"100\">\n          <template #default=\"{ row }\">\n            <StateBadge :state=\"row.state\" :map=\"INTERVIEW_STATE_MAP\" />\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\n          <template #default=\"{ row }\">\n            <el-button\n              v-if=\"row.state === 'pending'\"\n              size=\"small\"\n              type=\"success\"\n              @click=\"handleConfirm(row)\"\n            >\n              确认\n            </el-button>\n            <el-button\n              v-if=\"row.state === 'pending' || row.state === 'confirmed'\"\n              size=\"small\"\n              type=\"danger\"\n              @click=\"handleCancel(row)\"\n            >\n              取消\n            </el-button>\n            <el-button v-if=\"row.remark\" text @click=\"showRemark(row)\">备注</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <EmptyState v-if=\"!loading && !list.length\" text=\"暂无面试安排\" />\n    </el-card>\n\n    <div v-if=\"total > 0\" class=\"pagination\">\n      <el-pagination\n        v-model:current-page=\"query.current\"\n        v-model:page-size=\"query.size\"\n        :total=\"total\"\n        :page-sizes=\"[10, 20, 50]\"\n        layout=\"total, sizes, prev, pager, next, jumper\"\n        background\n        @current-change=\"handlePageChange\"\n        @size-change=\"handleSizeChange\"\n      />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { myInterviews, confirmInterview, cancelInterview } from '@/api/interview'\nimport { usePagination } from '@/composables/usePagination'\nimport { formatDateTime } from '@/utils/format'\nimport { INTERVIEW_STATE_MAP } from '@/utils/enums'\nimport { success } from '@/utils/message'\nimport { ElMessageBox, ElMessage } from 'element-plus'\nimport PageHeader from '@/components/PageHeader.vue'\nimport StateBadge from '@/components/StateBadge.vue'\nimport EmptyState from '@/components/EmptyState.vue'\n\nconst { query, list, total, loading, fetchList, handlePageChange, handleSizeChange, handleSearch } =\n  usePagination(myInterviews, { state: '', current: 1, size: 10 })\n\nasync function handleConfirm(row) {\n  await confirmInterview(row.interviewId)\n  success('已确认面试')\n  fetchList()\n}\n\nasync function handleCancel(row) {\n  try {\n    await ElMessageBox.confirm('确定取消这场面试吗？', '提示', {\n      confirmButtonText: '取消面试',\n      cancelButtonText: '保留',\n      type: 'warning',\n    })\n  } catch {\n    return\n  }\n  await cancelInterview(row.interviewId)\n  success('已取消面试')\n  fetchList()\n}\n\nfunction showRemark(row) {\n  ElMessage.info(row.remark)\n}\n\nonMounted(fetchList)\n</script>\n\n<style scoped>\n.pagination {\n  margin-top: 16px;\n  text-align: right;\n}\n</style>\n"],"mappings":"AAsEA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;AACnC,SAASC,YAAY,EAAEC,gBAAgB,EAAEC,eAAe,QAAQ,iBAAgB;AAChF,SAASC,aAAa,QAAQ,6BAA4B;AAC1D,SAASC,cAAc,QAAQ,gBAAe;AAC9C,SAASC,mBAAmB,QAAQ,eAAc;AAClD,SAASC,OAAO,QAAQ,iBAAgB;AACxC,SAASC,YAAY,EAAEC,SAAS,QAAQ,cAAa;AACrD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;AACnD,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAM;MAAEC,KAAK;MAAEC,IAAI;MAAEC,KAAK;MAAEC,OAAO;MAAEC,SAAS;MAAEC,gBAAgB;MAAEC,gBAAgB;MAAEC;IAAa,CAAC,GAChGhB,aAAa,CAACH,YAAY,EAAE;MAAEoB,KAAK,EAAE,EAAE;MAAEC,OAAO,EAAE,CAAC;MAAEC,IAAI,EAAE;IAAG,CAAC;IAEjE,eAAeC,aAAaA,CAACC,GAAG,EAAE;MAChC,MAAMvB,gBAAgB,CAACuB,GAAG,CAACC,WA