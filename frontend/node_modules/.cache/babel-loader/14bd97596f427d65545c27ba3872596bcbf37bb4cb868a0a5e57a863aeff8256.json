{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { computed } from 'vue';\nexport default {\n  __name: 'ResumePreview',\n  props: {\n    // 直接传入的简历对象（学生端复用时可传完整简历）\n    resume: {\n      type: Object,\n      default: () => ({})\n    },\n    // 投递记录里的 resumeSnapshot（JSON 字符串）\n    snapshot: {\n      type: String,\n      default: ''\n    }\n  },\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const props = __props;\n    const DEGREE_LABELS = {\n      college: '专科',\n      bachelor: '本科',\n      master: '硕士',\n      doctor: '博士'\n    };\n    function degreeLabel(code) {\n      return DEGREE_LABELS[code] || code || '-';\n    }\n\n    /** 解析快照 JSON，失败返回 null */\n    const snapObj = computed(() => {\n      if (!props.snapshot) return null;\n      try {\n        const parsed = JSON.parse(props.snapshot);\n        return parsed && typeof parsed === 'object' ? parsed : null;\n      } catch {\n        return null;\n      }\n    });\n\n    /** 合并取值：resume 优先，快照兜底 */\n    function pick(field) {\n      return props.resume?.[field] || snapObj.value?.[field] || '';\n    }\n    const title = computed(() => pick('title') || '简历');\n\n    /** 教育经历：优先 resume.eduJson，其次快照里的 eduJson（均为 JSON 字符串） */\n    const eduList = computed(() => {\n      const raw = props.resume?.eduJson || snapObj.value?.eduJson;\n      if (!raw) return [];\n      try {\n        const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n        return Array.isArray(parsed) ? parsed : [];\n      } catch {\n        return [];\n      }\n    });\n    const skill = computed(() => pick('skill'));\n    const projectExp = computed(() => pick('projectExp'));\n    const selfEval = computed(() => pick('selfEval'));\n    const cont = computed(() => pick('cont'));\n    const basic = computed(() => ({\n      studentName: snapObj.value?.studentName || props.resume?.studentName || '',\n      studentNo: snapObj.value?.studentNo || props.resume?.studentNo || '',\n      college: snapObj.value?.college || props.resume?.college || '',\n      major: snapObj.value?.major || props.resume?.major || ''\n    }));\n    const hasBasic = computed(() => Object.values(basic.value).some(Boolean));\n    const hasContent = computed(() => hasBasic.value || eduList.value.length > 0 || !!(skill.value || projectExp.value || selfEval.value || cont.value));\n\n    /** 快照解析失败时才回退显示原始 JSON */\n    const rawFallback = computed(() => !!props.snapshot && !snapObj.value);\n    const __returned__ = {\n      props,\n      DEGREE_LABELS,\n      degreeLabel,\n      snapObj,\n      pick,\n      title,\n      eduList,\n      skill,\n      projectExp,\n      selfEval,\n      cont,\n      basic,\n      hasBasic,\n      hasContent,\n      rawFallback,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["computed","props","__props","DEGREE_LABELS","college","bachelor","master","doctor","degreeLabel","code","snapObj","snapshot","parsed","JSON","parse","pick","field","resume","value","title","eduList","raw","eduJson","Array","isArray","skill","projectExp","selfEval","cont","basic","studentName","studentNo","major","hasBasic","Object","values","some","Boolean","hasContent","length","rawFallback"],"sources":["F:/sxzp/project0/frontend/new/src/components/ResumePreview.vue"],"sourcesContent":["<template>\n  <div class=\"resume-preview\">\n    <h3 class=\"resume-title\">{{ title }}</h3>\n\n    <!-- 学生基本信息（企业端来自投递快照） -->\n    <el-descriptions\n      v-if=\"hasBasic\"\n      :column=\"2\"\n      size=\"small\"\n      border\n      class=\"basic-info\"\n    >\n      <el-descriptions-item v-if=\"basic.studentName\" label=\"姓名\">\n        {{ basic.studentName }}\n      </el-descriptions-item>\n      <el-descriptions-item v-if=\"basic.studentNo\" label=\"学号\">\n        {{ basic.studentNo }}\n      </el-descriptions-item>\n      <el-descriptions-item v-if=\"basic.college\" label=\"学院\">\n        {{ basic.college }}\n      </el-descriptions-item>\n      <el-descriptions-item v-if=\"basic.major\" label=\"专业\">\n        {{ basic.major }}\n      </el-descriptions-item>\n    </el-descriptions>\n\n    <!-- 教育经历（表格） -->\n    <section v-if=\"eduList.length\" class=\"section\">\n      <h4>教育经历</h4>\n      <el-table :data=\"eduList\" size=\"small\" border class=\"edu-table\">\n        <el-table-column prop=\"school\" label=\"学校\" min-width=\"120\" />\n        <el-table-column prop=\"major\" label=\"专业\" min-width=\"100\" />\n        <el-table-column label=\"学历\" width=\"90\">\n          <template #default=\"{ row }\">{{ degreeLabel(row.degree) }}</template>\n        </el-table-column>\n        <el-table-column label=\"起止时间\" min-width=\"170\">\n          <template #default=\"{ row }\">\n            {{ row.startDate || '?' }} ~ {{ row.endDate || '至今' }}\n          </template>\n        </el-table-column>\n      </el-table>\n    </section>\n\n    <section v-if=\"skill\" class=\"section\">\n      <h4>技能与证书</h4>\n      <p class=\"content\">{{ skill }}</p>\n    </section>\n\n    <section v-if=\"projectExp\" class=\"section\">\n      <h4>项目/实践经历</h4>\n      <p class=\"content\">{{ projectExp }}</p>\n    </section>\n\n    <section v-if=\"selfEval\" class=\"section\">\n      <h4>自我评价</h4>\n      <p class=\"content\">{{ selfEval }}</p>\n    </section>\n\n    <section v-if=\"cont\" class=\"section\">\n      <h4>完整简历</h4>\n      <pre class=\"content-pre\">{{ cont }}</pre>\n    </section>\n\n    <!-- 兜底：快照无法解析时才显示原始文本 -->\n    <section v-if=\"rawFallback\" class=\"section\">\n      <h4>简历快照</h4>\n      <pre class=\"content-pre\">{{ snapshot }}</pre>\n    </section>\n\n    <el-empty v-if=\"!hasContent && !rawFallback\" description=\"暂无简历内容\" :image-size=\"80\" />\n  </div>\n</template>\n\n<script setup>\nimport { computed } from 'vue'\n\nconst props = defineProps({\n  // 直接传入的简历对象（学生端复用时可传完整简历）\n  resume: { type: Object, default: () => ({}) },\n  // 投递记录里的 resumeSnapshot（JSON 字符串）\n  snapshot: { type: String, default: '' },\n})\n\nconst DEGREE_LABELS = {\n  college: '专科',\n  bachelor: '本科',\n  master: '硕士',\n  doctor: '博士',\n}\n\nfunction degreeLabel(code) {\n  return DEGREE_LABELS[code] || code || '-'\n}\n\n/** 解析快照 JSON，失败返回 null */\nconst snapObj = computed(() => {\n  if (!props.snapshot) return null\n  try {\n    const parsed = JSON.parse(props.snapshot)\n    return parsed && typeof parsed === 'object' ? parsed : null\n  } catch {\n    return null\n  }\n})\n\n/** 合并取值：resume 优先，快照兜底 */\nfunction pick(field) {\n  return props.resume?.[field] || snapObj.value?.[field] || ''\n}\n\nconst title = computed(() => pick('title') || '简历')\n\n/** 教育经历：优先 resume.eduJson，其次快照里的 eduJson（均为 JSON 字符串） */\nconst eduList = computed(() => {\n  const raw = props.resume?.eduJson || snapObj.value?.eduJson\n  if (!raw) return []\n  try {\n    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw\n    return Array.isArray(parsed) ? parsed : []\n  } catch {\n    return []\n  }\n})\n\nconst skill = computed(() => pick('skill'))\nconst projectExp = computed(() => pick('projectExp'))\nconst selfEval = computed(() => pick('selfEval'))\nconst cont = computed(() => pick('cont'))\n\nconst basic = computed(() => ({\n  studentName: snapObj.value?.studentName || props.resume?.studentName || '',\n  studentNo: snapObj.value?.studentNo || props.resume?.studentNo || '',\n  college: snapObj.value?.college || props.resume?.college || '',\n  major: snapObj.value?.major || props.resume?.major || '',\n}))\n\nconst hasBasic = computed(() => Object.values(basic.value).some(Boolean))\n\nconst hasContent = computed(\n  () =>\n    hasBasic.value ||\n    eduList.value.length > 0 ||\n    !!(skill.value || projectExp.value || selfEval.value || cont.value)\n)\n\n/** 快照解析失败时才回退显示原始 JSON */\nconst rawFallback = computed(() => !!props.snapshot && !snapObj.value)\n</script>\n\n<style scoped>\n.resume-preview {\n  font-size: 14px;\n  color: #303133;\n}\n.resume-title {\n  margin: 0 0 16px;\n  font-size: 18px;\n}\n.basic-info {\n  margin-bottom: 16px;\n}\n.edu-table {\n  width: 100%;\n}\n.section {\n  margin-bottom: 16px;\n}\n.section h4 {\n  margin: 0 0 8px;\n  font-size: 14px;\n  color: #409eff;\n  border-left: 3px solid #409eff;\n  padding-left: 8px;\n}\n.content {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n}\n.content-pre {\n  margin: 0;\n  white-space: pre-wrap;\n  line-height: 1.7;\n  color: #606266;\n  font-family: inherit;\n}\n</style>\n"],"mappings":";;AA0EA,SAASA,QAAQ,QAAQ,KAAI;;;;;;;;;;;;;;;;;;;IAE7B,MAAMC,KAAK,GAAGC,OAAA;IAOd,MAAMC,aAAa,GAAG;MACpBC,OAAO,EAAE,IAAI;MACbC,QAAQ,EAAE,IAAI;MACdC,MAAM,EAAE,IAAI;MACZC,MAAM,EAAE;IACV;IAEA,SAASC,WAAWA,CAACC,IAAI,EAAE;MACzB,OAAON,aAAa,CAACM,IAAI,CAAC,IAAIA,IAAI,IAAI,GAAE;IAC1C;;IAEA;IACA,MAAMC,OAAO,GAAGV,QAAQ,CAAC,MAAM;MAC7B,IAAI,CAACC,KAAK,CAACU,QAAQ,EAAE,OAAO,IAAG;MAC/B,IAAI;QACF,MAAMC,MAAM,GAAGC,IAAI,CAACC,KAAK,CAACb,KAAK,CAACU,QAAQ;QACxC,OAAOC,MAAM,IAAI,OAAOA,MAAM,KAAK,QAAQ,GAAGA,MAAM,GAAG,IAAG;MAC5D,CAAC,CAAC,MAAM;QACN,OAAO,IAAG;MACZ;IACF,CAAC;;IAED;IACA,SAASG,IAAIA,CAACC,KAAK,EAAE;MACnB,OAAOf,KAAK,CAACgB,MAAM,GAAGD,KAAK,CAAC,IAAIN,OAAO,CAACQ,KAAK,GAAGF,KAAK,CAAC,IAAI,EAAC;IAC7D;IAEA,MAAMG,KAAK,GAAGnB,QAAQ,CAAC,MAAMe,IAAI,CAAC,OAAO,CAAC,IAAI,IAAI;;IAElD;IACA,MAAMK,OAAO,GAAGpB,QAAQ,CAAC,MAAM;MAC7B,MAAMqB,GAAG,GAAGpB,KAAK,CAACgB,MAAM,EAAEK,OAAO,IAAIZ,OAAO,CAACQ,KAAK,EAAEI,OAAM;MAC1D,IAAI,CAACD,GAAG,EAAE,OAAO,EAAC;MAClB,IAAI;QACF,MAAMT,MAAM,GAAG,OAAOS,GAAG,KAAK,QAAQ,GAAGR,IAAI,CAACC,KAAK,CAACO,GAAG,CAAC,GAAGA,GAAE;QAC7D,OAAOE,KAAK,CAACC,OAAO,CAACZ,MAAM,CAAC,GAAGA,MAAM,GAAG,EAAC;MAC3C,CAAC,CAAC,MAAM;QACN,OAAO,EAAC;MACV;IACF,CAAC;IAED,MAAMa,KAAK,GAAGzB,QAAQ,CAAC,MAAMe,IAAI,CAAC,OAAO,CAAC;IAC1C,MAAMW,UAAU,GAAG1B,QAAQ,CAAC,MAAMe,IAAI,CAAC,YAAY,CAAC;IACpD,MAAMY,QAAQ,GAAG3B,QAAQ,CAAC,MAAMe,IAAI,CAAC,UAAU,CAAC;IAChD,MAAMa,IAAI,GAAG5B,QAAQ,CAAC,MAAMe,IAA