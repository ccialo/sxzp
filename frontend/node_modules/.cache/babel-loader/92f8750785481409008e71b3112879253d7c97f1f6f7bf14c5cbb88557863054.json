{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, reactive, computed, onMounted } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { saveJob, jobDetail } from '@/api/job';\nimport { useDictStore } from '@/stores/dict';\nimport { success } from '@/utils/message';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  __name: 'JobEdit',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const router = useRouter();\n    const dictStore = useDictStore();\n    const formRef = ref();\n    const loading = ref(false);\n    const saving = ref(false);\n    const isEdit = computed(() => !!route.query.id);\n    const jobTypeList = ref([]);\n    const form = reactive({\n      jobId: null,\n      jobTitle: '',\n      jobType: '',\n      headcount: 1,\n      workPlace: '',\n      category: '',\n      benefitMoney: 0,\n      startDate: '',\n      endDate: '',\n      duty: '',\n      req: '',\n      submit: false\n    });\n    const rules = {\n      jobTitle: [{\n        required: true,\n        message: '请输入岗位名称',\n        trigger: 'blur'\n      }],\n      jobType: [{\n        required: true,\n        message: '请选择实习类型',\n        trigger: 'change'\n      }],\n      headcount: [{\n        required: true,\n        message: '请输入拟招人数',\n        trigger: 'blur'\n      }]\n    };\n    async function loadDetail() {\n      const id = route.query.id;\n      if (!id) return;\n      loading.value = true;\n      try {\n        const data = await jobDetail(id);\n        Object.assign(form, {\n          jobId: data.jobId,\n          jobTitle: data.jobTitle,\n          jobType: data.jobType,\n          headcount: data.headcount,\n          workPlace: data.workPlace,\n          category: data.category,\n          benefitMoney: data.benefitMoney,\n          startDate: data.startDate,\n          endDate: data.endDate,\n          duty: data.duty,\n          req: data.req,\n          submit: false\n        });\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function handleSave() {\n      if (!formRef.value) return;\n      try {\n        await formRef.value.validate();\n      } catch {\n        return;\n      }\n      saving.value = true;\n      try {\n        await saveJob({\n          ...form\n        });\n        success(form.submit ? '已提交审核' : '已存为草稿');\n        router.push('/company/jobs');\n      } finally {\n        saving.value = false;\n      }\n    }\n    onMounted(async () => {\n      try {\n        jobTypeList.value = await dictStore.load('job_type');\n      } catch {\n        // 忽略\n      }\n      loadDetail();\n    });\n    const __returned__ = {\n      route,\n      router,\n      dictStore,\n      formRef,\n      loading,\n      saving,\n      isEdit,\n      jobTypeList,\n      form,\n      rules,\n      loadDetail,\n      handleSave,\n      ref,\n      reactive,\n      computed,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useRouter() {\n        return useRouter;\n      },\n      get saveJob() {\n        return saveJob;\n      },\n      get jobDetail() {\n        return jobDetail;\n      },\n      get useDictStore() {\n        return useDictStore;\n      },\n      get success() {\n        return success;\n      },\n      PageHeader\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","computed","onMounted","useRoute","useRouter","saveJob","jobDetail","useDictStore","success","PageHeader","route","router","dictStore","formRef","loading","saving","isEdit","query","id","jobTypeList","form","jobId","jobTitle","jobType","headcount","workPlace","category","benefitMoney","startDate","endDate","duty","req","submit","rules","required","message","trigger","loadDetail","value","data","Object","assign","handleSave","validate","push","load"],"sources":["F:/sxzp/project0/frontend/src/views/company/JobEdit.vue"],"sourcesContent":["<template>\n  <div class=\"job-edit\">\n    <PageHeader :title=\"isEdit ? '修改岗位' : '发布岗位'\">\n      <template #actions>\n        <el-button @click=\"$router.back()\">返回</el-button>\n      </template>\n    </PageHeader>\n\n    <el-card v-loading=\"loading\" shadow=\"never\">\n      <el-form\n        ref=\"formRef\"\n        :model=\"form\"\n        :rules=\"rules\"\n        label-width=\"120px\"\n        size=\"default\"\n        style=\"max-width: 720px\"\n      >\n        <el-form-item label=\"岗位名称\" prop=\"jobTitle\">\n          <el-input v-model=\"form.jobTitle\" placeholder=\"如：Java 后端开发实习生\" />\n        </el-form-item>\n        <el-form-item label=\"实习类型\" prop=\"jobType\">\n          <el-select v-model=\"form.jobType\" placeholder=\"请选择\" clearable style=\"width: 100%\">\n            <el-option\n              v-for=\"d in jobTypeList\"\n              :key=\"d.dictCode\"\n              :label=\"d.dictLabel\"\n              :value=\"d.dictCode\"\n            />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"拟招人数\" prop=\"headcount\">\n          <el-input-number v-model=\"form.headcount\" :min=\"1\" :max=\"999\" />\n        </el-form-item>\n        <el-form-item label=\"工作地点\" prop=\"workPlace\">\n          <el-input v-model=\"form.workPlace\" placeholder=\"如：北京/上海/远程\" />\n        </el-form-item>\n        <el-form-item label=\"岗位方向\" prop=\"category\">\n          <el-input v-model=\"form.category\" placeholder=\"如：研发/产品/运营\" />\n        </el-form-item>\n        <el-form-item label=\"实习津贴\" prop=\"benefitMoney\">\n          <el-input-number v-model=\"form.benefitMoney\" :min=\"0\" :precision=\"2\" :step=\"100\" />\n          <span class=\"unit\">元/月</span>\n        </el-form-item>\n        <el-row :gutter=\"12\">\n          <el-col :span=\"12\">\n            <el-form-item label=\"开始日期\" prop=\"startDate\">\n              <el-date-picker v-model=\"form.startDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"选择开始日期\" style=\"width: 100%\" />\n            </el-form-item>\n          </el-col>\n          <el-col :span=\"12\">\n            <el-form-item label=\"结束日期\" prop=\"endDate\">\n              <el-date-picker v-model=\"form.endDate\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"选择结束日期\" style=\"width: 100%\" />\n            </el-form-item>\n          </el-col>\n        </el-row>\n        <el-form-item label=\"岗位职责\" prop=\"duty\">\n          <el-input v-model=\"form.duty\" type=\"textarea\" :rows=\"5\" placeholder=\"请输入岗位职责\" />\n        </el-form-item>\n        <el-form-item label=\"任职要求\" prop=\"req\">\n          <el-input v-model=\"form.req\" type=\"textarea\" :rows=\"5\" placeholder=\"请输入任职要求\" />\n        </el-form-item>\n        <el-form-item label=\"提交审核\">\n          <el-switch v-model=\"form.submit\" :active-value=\"true\" :inactive-value=\"false\" active-text=\"保存后提交审核\" inactive-text=\"存为草稿\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" :loading=\"saving\" @click=\"handleSave\">保存</el-button>\n          <el-button @click=\"$router.back()\">取消</el-button>\n        </el-form-item>\n      </el-form>\n    </el-card>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, computed, onMounted } from 'vue'\nimport { useRoute, useRouter } from 'vue-router'\nimport { saveJob, jobDetail } from '@/api/job'\nimport { useDictStore } from '@/stores/dict'\nimport { success } from '@/utils/message'\nimport PageHeader from '@/components/PageHeader.vue'\n\nconst route = useRoute()\nconst router = useRouter()\nconst dictStore = useDictStore()\n\nconst formRef = ref()\nconst loading = ref(false)\nconst saving = ref(false)\nconst isEdit = computed(() => !!route.query.id)\nconst jobTypeList = ref([])\n\nconst form = reactive({\n  jobId: null,\n  jobTitle: '',\n  jobType: '',\n  headcount: 1,\n  workPlace: '',\n  category: '',\n  benefitMoney: 0,\n  startDate: '',\n  endDate: '',\n  duty: '',\n  req: '',\n  submit: false,\n})\n\nconst rules = {\n  jobTitle: [{ required: true, message: '请输入岗位名称', trigger: 'blur' }],\n  jobType: [{ required: true, message: '请选择实习类型', trigger: 'change' }],\n  headcount: [{ required: true, message: '请输入拟招人数', trigger: 'blur' }],\n}\n\nasync function loadDetail() {\n  const id = route.query.id\n  if (!id) return\n  loading.value = true\n  try {\n    const data = await jobDetail(id)\n    Object.assign(form, {\n      jobId: data.jobId,\n      jobTitle: data.jobTitle,\n      jobType: data.jobType,\n      headcount: data.headcount,\n      workPlace: data.workPlace,\n      category: data.category,\n      benefitMoney: data.benefitMoney,\n      startDate: data.startDate,\n      endDate: data.endDate,\n      duty: data.duty,\n      req: data.req,\n      submit: false,\n    })\n  } finally {\n    loading.value = false\n  }\n}\n\nasync function handleSave() {\n  if (!formRef.value) return\n  try {\n    await formRef.value.validate()\n  } catch {\n    return\n  }\n  saving.value = true\n  try {\n    await saveJob({ ...form })\n    success(form.submit ? '已提交审核' : '已存为草稿')\n    router.push('/company/jobs')\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(async () => {\n  try {\n    jobTypeList.value = await dictStore.load('job_type')\n  } catch {\n    // 忽略\n  }\n  loadDetail()\n})\n</script>\n\n<style scoped>\n.unit {\n  margin-left: 8px;\n  color: #909399;\n}\n</style>\n"],"mappings":";AA0EA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AACvD,SAASC,QAAQ,EAAEC,SAAS,QAAQ,YAAW;AAC/C,SAASC,OAAO,EAAEC,SAAS,QAAQ,WAAU;AAC7C,SAASC,YAAY,QAAQ,eAAc;AAC3C,SAASC,OAAO,QAAQ,iBAAgB;AACxC,OAAOC,UAAU,MAAM,6BAA4B;;;;;;;IAEnD,MAAMC,KAAK,GAAGP,QAAQ,CAAC;IACvB,MAAMQ,MAAM,GAAGP,SAAS,CAAC;IACzB,MAAMQ,SAAS,GAAGL,YAAY,CAAC;IAE/B,MAAMM,OAAO,GAAGd,GAAG,CAAC;IACpB,MAAMe,OAAO,GAAGf,GAAG,CAAC,KAAK;IACzB,MAAMgB,MAAM,GAAGhB,GAAG,CAAC,KAAK;IACxB,MAAMiB,MAAM,GAAGf,Q